<view class="frame {{resolvedRatio || ratio}} {{compact ? 'compact' : ''}}" style="{{frameStyle}}">
  <view wx:if="{{!src || placeholder}}" class="placeholder" bindtap="open" role="button" aria-label="{{caption}}，{{copy.previewHint}}">
    <view class="crop crop-tl"></view><view class="crop crop-br"></view>
    <text class="placeholder-number">{{copy.text01}}</text>
    <view class="window"><view class="sun"></view><view class="sill"></view></view>
    <text class="placeholder-caption">{{caption}}</text>
    <text class="placeholder-hint">{{copy.text02}}</text>
  </view>
  <block wx:else>
    <image wx:if="{{slotAUrl}}" class="photo {{activeSlot === 'a' ? 'photo-front' : 'photo-back'}}" src="{{slotAUrl}}" mode="aspectFit" lazy-load="{{!loaded || activeSlot === 'a'}}" data-source="{{slotASource}}" data-url="{{slotAUrl}}" bindload="loadA" binderror="errorA" bindtap="open" aria-label="{{caption}}，{{copy.openHint}}" />
    <image wx:if="{{slotBUrl}}" class="photo {{activeSlot === 'b' ? 'photo-front' : 'photo-back'}}" src="{{slotBUrl}}" mode="aspectFit" lazy-load="{{!loaded || activeSlot === 'b'}}" data-source="{{slotBSource}}" data-url="{{slotBUrl}}" bindload="loadB" binderror="errorB" bindtap="open" aria-label="{{caption}}，{{copy.openHint}}" />
    <view wx:if="{{!loaded && !failed}}" class="loading">{{copy.text03}}</view>
    <view wx:if="{{failed}}" class="failed"><text>{{copy.text04}}</text><text class="failure-hint">{{failureHint}}</text><button class="retry" bindtap="retry">{{copy.text05}}</button><button class="retry" bindtap="open">{{copy.text06}}</button></view>
  </block>
</view>
