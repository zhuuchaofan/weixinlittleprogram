.lead-note { margin: 0 4rpx 24rpx; line-height: 1.7; }
.budget-row { gap: 20rpx; }
.budget-input-box { display: flex; align-items: center; gap: 8rpx; width: 240rpx; flex-shrink: 0; padding: 8rpx 20rpx; border-radius: var(--radius-sm); background: var(--sunken); }
.budget-input { flex: 1; min-width: 0; height: 64rpx; text-align: right; font-size: 30rpx; }
.save, button.save:not([size='mini']) { margin-top: 40rpx; }
