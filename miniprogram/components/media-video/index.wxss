.media-video{position:relative;background:#e9dfd1;border-radius:16rpx;overflow:hidden}video{width:100%;height:420rpx;background:#191715}.portrait video{height:640rpx}.square video{height:500rpx}.video-cover{position:relative;min-height:220rpx}.no-cover{height:260rpx;display:flex;align-items:center;justify-content:center;color:#785b4e}.play-button{position:absolute;z-index:5;left:50%;top:50%;transform:translate(-50%,-50%);padding:22rpx 30rpx;border-radius:64rpx;background:rgba(58,39,32,.72);color:#fff;font-size:26rpx;white-space:nowrap;pointer-events:none}.retry{font-size:24rpx;line-height:1.6;padding:20rpx;background:#f7f2e9;color:#783e3c}