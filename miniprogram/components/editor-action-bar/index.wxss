.editor-action-bar { position: sticky; z-index: 10; top: 0; display: flex; width: 100%; box-sizing: border-box; padding: 16rpx 0; background: var(--paper); border-bottom: 1rpx solid var(--line); }
.editor-action-bar > button { flex: 1 1 0%; width: 0; min-width: 0; max-width: 100%; min-height: 88rpx; margin: 0; padding: 18rpx 8rpx; font-size: 28rpx; line-height: 1.4; box-sizing: border-box; }
.editor-action-bar > button + button { margin-left: 18rpx; }