.footer { margin-top: 72rpx; padding: 36rpx 0 calc(42rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #d9ccbb; color: #736354; text-align: center; }
.signature { font-size: 24rpx; letter-spacing: 1rpx; line-height: 1.6; }
.cats { margin-top: 6rpx; font-size: 20rpx; letter-spacing: 3rpx; color: #9a8876; }
.links { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 24rpx; border-top: 1rpx solid #e5dacb; border-bottom: 1rpx solid #e5dacb; }
.links navigator, .links button { display: flex; justify-content: center; align-items: center; min-width: 0; min-height: 86rpx; margin: 0; padding: 16rpx 8rpx; font: inherit; font-size: 23rpx; color: #736354; line-height: 1.4; letter-spacing: .4rpx; background: transparent; border: 0; text-decoration: none; }
.links navigator + navigator, .links button + navigator { border-left: 1rpx solid #e5dacb; }
.links button::after { border: 0; }