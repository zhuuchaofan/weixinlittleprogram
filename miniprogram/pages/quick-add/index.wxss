.quick-card { margin-top: 24rpx; }
.quick-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 16rpx; }
.quick-title { font-size: 28rpx; font-weight: 700; }
.quick-input { width: 100%; min-height: 160rpx; padding: 20rpx; box-sizing: border-box; border: 1rpx solid var(--line); border-radius: var(--radius-sm); background: var(--surface); font-size: 30rpx; line-height: 1.6; }
.quick-tip { margin-top: 12rpx; }
.quick-go, button.quick-go:not([size='mini']) { margin-top: 32rpx; }
.quick-note { margin: 16rpx 4rpx 0; }
.save-bar { position: sticky; bottom: 0; padding: 20rpx 0 calc(20rpx + env(safe-area-inset-bottom)); background: var(--paper); }
.again, button.again:not([size='mini']) { margin-top: 8rpx; }
