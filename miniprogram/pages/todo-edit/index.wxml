<page-meta page-style="{{themeStyle}}" />
<view class="page">
  <block wx:if="{{id}}">
    <view class="field">
      <text class="field-label">内容</text>
      <input value="{{text}}" maxlength="{{limits.todoText}}" bindinput="inputText" />
    </view>
    <view class="field">
      <text class="field-label">清单</text>
      <view class="segmented">
        <view wx:for="{{kinds}}" wx:key="value" class="segment {{kind === item.value ? 'segment-on' : ''}}" data-field="kind" data-value="{{item.value}}" bindtap="choose">{{item.label}}</view>
      </view>
    </view>
    <view wx:if="{{kind === 'todo'}}" class="field">
      <text class="field-label">重复</text>
      <view class="segmented">
        <view wx:for="{{repeats}}" wx:key="value" class="segment {{repeat === item.value ? 'segment-on' : ''}}" data-field="repeat" data-value="{{item.value}}" bindtap="choose">{{item.label}}</view>
      </view>
      <view wx:if="{{repeat}}" class="small muted">勾完后自动生成下一条，到了日子才会出现在「要做的」里。</view>
    </view>
    <view class="field">
      <text class="field-label">谁来做</text>
      <view class="chips chips-fill">
        <view class="chip {{who === 'a' ? 'chip-on' : ''}}" data-field="who" data-value="a" bindtap="choose">{{names.a}}</view>
        <view class="chip {{who === 'b' ? 'chip-on' : ''}}" data-field="who" data-value="b" bindtap="choose">{{names.b}}</view>
        <view class="chip {{who === 'both' ? 'chip-on' : ''}}" data-field="who" data-value="both" bindtap="choose">一起</view>
      </view>
    </view>
  </block>
  <view wx:if="{{error}}" class="notice error">{{error}}</view>
  <block wx:if="{{id}}">
    <button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存</button>
    <button class="danger-button" bindtap="remove" disabled="{{busy}}">删除这条</button>
  </block>
</view>
