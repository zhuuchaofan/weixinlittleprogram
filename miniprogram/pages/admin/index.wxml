<view class="page"><view class="kicker">{{copy.text01}}</view><view class="title">{{copy.text02}}</view><view class="lead">{{copy.text03}}</view>
  <view wx:if="{{isMock}}" class="notice">{{copy.text04}}</view>
  <view wx:if="{{loading}}" class="status">{{copy.text05}}</view>
  <view wx:if="{{error}}" class="notice error">{{error}}<button class="text-button" bindtap="load">{{copy.text06}}</button></view>
  <view wx:if="{{authorized}}">
    <navigator class="photo-management-entry" hover-class="photo-management-entry-active" url="/pages/photos/index" aria-label="照片管理，上传照片与调整展示"><view class="photo-management-copy"><view class="photo-management-title serif">照片管理</view><view class="photo-management-description">添一张回忆，整理我们的纪念册</view></view><text class="photo-management-arrow">↗</text></navigator><navigator class="photo-management-entry" hover-class="photo-management-entry-active" url="/pages/program/index" aria-label="当天流程，安排主持环节与门口 Photo Booth"><view class="photo-management-copy"><view class="photo-management-title serif">{{copy.programTitle}}</view><view class="photo-management-description">{{copy.programDescription}}</view></view><view class="direction-chevron admin-chevron"></view></navigator>
    <view class="summary section"><view><text class="stat serif">{{summary.guests}}</text><text>{{copy.text07}}</text></view><view><text class="stat serif">{{summary.responses}}</text><text>{{copy.text08}}</text></view><view><text class="stat serif">{{messageSummary.messages}}</text><text>{{copy.text22}}</text></view></view>
    <view class="small muted">{{summary.attending}} {{copy.text09}} {{summary.declined}} {{copy.text10}}</view>
    <view class="inline section"><view class="section-title">{{copy.text11}}</view><button class="text-button" bindtap="load" disabled="{{loading}}">{{copy.text12}}</button></view>
    <view wx:if="{{!records.length}}" class="empty">{{copy.text13}}<view wx:if="{{isMock}}">{{copy.text14}}</view></view>
    <view wx:for="{{records}}" wx:key="id" class="guest"><view class="inline"><text class="guest-name">{{item.guestName}}</text><text class="tag">{{item.attending ? copy.text15 + item.partySize + copy.text16 : copy.text17}}</text></view><view class="guest-note">{{item.note || copy.text18}}</view><view class="record-time">{{copy.text20}}{{item.updatedAt}}</view></view>
    <button wx:if="{{nextCursor}}" class="secondary" bindtap="more" loading="{{loading}}" disabled="{{loading}}">{{copy.text19}}</button>
    <view class="inline section blessing-heading"><view class="section-title">{{copy.text21}}</view><text class="small muted">{{messageSummary.messages}} {{copy.text22}}</text></view>
    <view wx:if="{{!messages.length}}" class="empty">{{copy.text23}}<view wx:if="{{isMock}}">{{copy.text24}}</view></view>
    <view wx:for="{{messages}}" wx:key="id" class="guest blessing"><view class="inline"><text class="guest-name">{{item.signature || copy.text26}}</text><text class="tag">{{copy.text21}}</text></view><view class="guest-note">{{item.message}}</view><view class="record-time">{{copy.text20}}{{item.updatedAt}}</view></view>
    <button wx:if="{{messageNextCursor}}" class="secondary" bindtap="moreMessages" loading="{{loading}}" disabled="{{loading}}">{{copy.text25}}</button>
  </view><page-footer />
</view>
