.summary { display: flex; gap: 18rpx; padding: 28rpx 0; border-top: 1rpx solid var(--line); border-bottom: 1rpx solid var(--line); margin-bottom: 20rpx; }.summary > view { flex: 1; display: flex; flex-direction: column; font-size: 24rpx; min-width: 0; }.stat { font-size: 62rpx; color: var(--accent); }.guest { border-top: 1rpx solid var(--line); padding: 26rpx 0; }.guest-name { font-size: 33rpx; flex: 1; min-width: 0; }.guest-note { margin: 14rpx 0; white-space: pre-wrap; }.section-title { margin-bottom: 0; }.record-time { color: var(--muted); font-size: 22rpx; letter-spacing: 0.3rpx; }.photo-management-entry { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-top: 34rpx; padding: 28rpx 30rpx; min-height: 132rpx; border: 1rpx solid var(--line); background: #fcf9f4; border-radius: 6rpx; }.photo-management-copy { flex: 1; min-width: 0; }.photo-management-title { color: var(--ink); font-size: 35rpx; line-height: 1.4; }.photo-management-description { margin-top: 10rpx; color: var(--muted); font-size: 24rpx; line-height: 1.6; }.photo-management-arrow { color: var(--accent); font-size: 38rpx; flex-shrink: 0; }.photo-management-entry-active { background: #eee3d4; }.blessing-heading { margin-top: 54rpx; }.blessing .tag { color: var(--accent); background: #efe1d5; }
