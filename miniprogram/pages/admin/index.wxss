.summary { display: flex; gap: 28rpx; padding: 28rpx 0; border-top: 1rpx solid var(--line); border-bottom: 1rpx solid var(--line); margin-bottom: 20rpx; }.summary > view { flex: 1; display: flex; flex-direction: column; font-size: 25rpx; }.stat { font-size: 70rpx; color: var(--accent); }.guest { border-top: 1rpx solid var(--line); padding: 26rpx 0; }.guest-name { font-size: 33rpx; flex: 1; min-width: 0; }.guest-note { margin: 14rpx 0; white-space: pre-wrap; }.section-title { margin-bottom: 0; }
