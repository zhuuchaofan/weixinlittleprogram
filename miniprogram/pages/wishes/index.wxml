<page-meta page-style="{{themeStyle}}" />
<view class="page">
  <view wx:if="{{done.length}}" class="foot-entry" bindtap="footprints" hover-class="list-row-active" aria-role="button">我们的足迹 · 去过 {{done.length}} 个地方 ›</view>
  <view class="composer">
    <input class="composer-input" value="{{title}}" maxlength="{{limits.wishTitle}}" placeholder="想去哪儿 / 想做什么…" confirm-type="done" confirm-hold bindinput="inputTitle" bindconfirm="add" />
    <button class="primary btn-inline" bindtap="add" disabled="{{busy}}">添加</button>
  </view>
  <view wx:if="{{error}}" class="notice error">{{error}}<button class="text-button" bindtap="load">再试一次</button></view>
  <view wx:if="{{loading && !wishes.length}}" class="status"><view class="status-paws" aria-hidden="true"><image class="status-paws-img" src="/images/themes/{{themeId}}/paw-trail.svg" /></view>正在读取…</view>
  <view wx:elif="{{!open.length && !done.length}}" class="empty list-gap"><image class="empty-cat" src="/images/themes/{{themeId}}/cat-sleep.svg" aria-hidden="true" />想去的地方、想一起做的事，先记下来。</view>

  <view wx:if="{{open.length}}" class="list list-gap">
    <view wx:for="{{open}}" wx:key="id" class="list-row wish-row">
      <view class="tick" data-id="{{item.id}}" bindtap="toggle" aria-role="checkbox" aria-checked="false" aria-label="去过了 {{item.title}}"><view class="tick-box"></view></view>
      <view class="row-main wish-main" data-id="{{item.id}}" bindtap="open" hover-class="list-row-active">
        <view class="row-title">{{item.title}}</view>
        <view wx:if="{{item.theirs && item.mine}}" class="row-sub">你们俩都想去</view>
        <view wx:elif="{{item.theirs}}" class="row-sub">TA 也想去</view>
        <view wx:if="{{item.subText}}" class="row-sub">{{item.subText}}</view>
      </view>
      <view class="chip want-chip {{item.mine ? 'chip-on' : ''}}" data-id="{{item.id}}" bindtap="want" aria-role="button" aria-label="我也想去 {{item.title}}">{{item.mine ? '想去 ✓' : '我想去'}}</view>
    </view>
  </view>

  <block wx:if="{{done.length}}">
    <view class="fold-head" bindtap="toggleDone" aria-role="button">去过的 {{done.length}} {{showDone ? '▾' : '▸'}}</view>
    <view wx:if="{{showDone}}" class="list">
      <view wx:for="{{done}}" wx:key="id" class="list-row wish-row">
        <view class="tick" data-id="{{item.id}}" bindtap="toggle" aria-role="checkbox" aria-checked="true" aria-label="取消去过了 {{item.title}}"><view class="tick-box tick-on"><image class="tick-paw" src="/images/ui/paw.png" /></view></view>
        <view class="row-main wish-main" data-id="{{item.id}}" bindtap="open" hover-class="list-row-active">
          <view class="row-title">{{item.title}}</view>
          <view class="row-sub">{{item.subText}}</view>
        </view>
        <image wx:if="{{item.thumb}}" class="wish-thumb" src="{{item.thumb}}" mode="aspectFill" />
      </view>
    </view>
  </block>
  <view class="page-end"></view>
</view>
