<view class="page {{reduceMotion ? '' : 'entrance'}}">
  <view class="masthead">
    <text class="brand serif">{{appConfig.names}}</text>
    <view class="masthead-actions"><music-control variant="masthead" /><navigator class="edition" url="/pages/invitation/index">{{copy.invitationEntry}}</navigator></view>
  </view>
  <view wx:if="{{isMock}}" class="demo">{{copy.text02}}</view>

  <view wx:if="{{eventStatus.phase !== 'after'}}" class="event-poster">
    <view class="poster-kicker">{{eventStatus.phase === 'today' ? copy.todayKicker : copy.posterKicker}}</view>
    <view class="poster-title serif">{{copy.posterTitle}}</view>
    <view wx:if="{{eventStatus.phase === 'before'}}" class="countdown-block">
      <view class="countdown-caption">{{copy.beforeKicker}}</view>
      <view class="countdown-line serif"><text class="countdown-number">{{eventStatus.daysUntil}}</text><text class="countdown-unit">天</text></view>
    </view>
    <view class="poster-meta"><text>{{appConfig.dateNote}}</text><text class="poster-dot">·</text><text>{{appConfig.time}}</text></view>
    <view wx:if="{{appConfig.confirmed && appConfig.location}}" class="arrival-strip" bindtap="map" role="button" hover-class="arrival-strip-active" aria-label="{{appConfig.venue}}，{{copy.mapCta}}">
      <view class="arrival-venue serif">{{appConfig.venue}}</view>
      <view class="arrival-action"><text>{{copy.mapCta}}</text><view class="direction-chevron"></view></view>
    </view>
    <view wx:else class="arrival-strip arrival-static"><view class="arrival-venue serif">{{appConfig.venue}}</view></view>
    <view wx:if="{{eventStatus.phase === 'today' && programReady}}" class="event-program">
      <view class="program-heading"><view><view class="kicker">现场安排 / TODAY</view><view class="program-title serif">{{eventProgram.title}}</view></view><view class="program-count">{{visibleProgramItems.length}} 项</view></view>
      <view wx:if="{{eventProgram.lead}}" class="program-lead">{{eventProgram.lead}}</view>
      <view wx:for="{{visibleProgramItems}}" wx:key="id" class="program-item"><text class="program-number serif">{{index + 1 < 10 ? '0' : ''}}{{index + 1}}</text><view class="program-copy"><view class="program-item-title">{{item.title}}</view><view wx:if="{{item.description}}" class="program-item-description">{{item.description}}</view></view><text wx:if="{{item.time}}" class="program-time">{{item.time}}</text></view>
      <view wx:if="{{eventProgram.photoBooth.enabled}}" class="photo-booth"><view class="booth-mark">PHOTO</view><view class="booth-copy"><view class="booth-title serif">{{eventProgram.photoBooth.title}}</view><view wx:if="{{eventProgram.photoBooth.description}}" class="booth-description">{{eventProgram.photoBooth.description}}</view></view><text wx:if="{{eventProgram.photoBooth.time}}" class="booth-time">{{eventProgram.photoBooth.time}}</text></view>
    </view>
    <button class="primary photo-cta" bindtap="enter">{{copy.photoCta}}</button>
    <navigator wx:if="{{!collectionClosed}}" class="blessing-cta" url="/pages/guestbook/index">{{copy.blessingCta}}</navigator>
  </view>

  <view wx:else class="memory-intro">
    <view class="poster-kicker">{{copy.afterKicker}}</view>
    <view class="memory-title serif">{{copy.afterTitle}}</view>
    <view class="memory-lead">{{copy.afterLead}}</view>
    <button class="primary photo-cta after-photo-cta" bindtap="enter">{{copy.photoCta}}</button>
    <navigator wx:if="{{!collectionClosed}}" class="blessing-cta" url="/pages/guestbook/index">{{copy.blessingCta}}</navigator>
  </view>

  <view class="photo-opening">
    <view class="kicker">{{eventStatus.phase === 'after' ? copy.afterPhotoKicker : copy.photoKicker}}</view>
    <view wx:if="{{!photoContentReady}}" class="hero-pending" aria-label="照片正在准备"></view>
    <block wx:else>
      <view class="hero">
        <photo-frame src="{{coverPhoto.thumbnail}}" caption="{{coverPhoto.caption}}" placeholder="{{coverPhoto.placeholder}}" bind:open="preview" />
        <view class="photo-label">{{copy.text03}}</view>
      </view>
    </block>
  </view>

  <view class="secondary-navigation section">
    <view class="kicker">{{copy.text05}}</view>
    <navigator wx:for="{{navigation}}" wx:key="url" url="{{item.url}}" class="nav-row">
      <text class="nav-number">{{item.number}}</text>
      <view class="nav-copy"><view class="serif nav-title">{{item.title}}</view><view class="small muted">{{item.description}}</view></view>
      <view class="direction-chevron nav-chevron"></view>
    </navigator>
  </view>

  <button class="cat-note" bindtap="cat">{{appConfig.cats[0]}}{{copy.text06}}{{appConfig.cats[1]}}{{copy.text07}} <text>{{catVisible ? '−' : '＋'}}</text></button>
  <view wx:if="{{catVisible}}" class="cat-reveal">
    <view>{{appConfig.catMessage}}</view>
    <view wx:if="{{!catPhotos.length}}" class="small muted">球球和布丁的照片正在整理，过些时候再来看看呀。</view>
    <view class="cat-photos">
      <view wx:for="{{catColumns}}" wx:key="id" wx:for-item="column" class="cat-column">
        <view wx:for="{{column.photos}}" wx:key="id" wx:for-item="photo" class="cat-photo">
          <photo-frame src="{{photo.thumbnail}}" caption="{{photo.caption}}" placeholder="{{photo.placeholder}}" ratio="{{photo.ratio}}" compact="{{true}}" data-id="{{photo.id}}" bind:open="previewCat" />
          <view class="cat-caption">{{photo.catLabel === 'qiuqiu' ? appConfig.cats[0] : appConfig.cats[1]}}</view>
          <view wx:if="{{photo.caption && photo.caption !== appConfig.cats[0] && photo.caption !== appConfig.cats[1]}}" class="cat-description">{{photo.caption}}</view>
        </view>
      </view>
    </view>
    <navigator class="cat-album-link" url="/pages/gallery/index?category=daily">查看更多日常照 ↗</navigator>
  </view>
  <page-footer music-enabled="{{false}}" />
</view>
