<page-meta page-style="{{themeStyle}}" />
<wxs module="money" src="../../wxs/money.wxs" />
<view class="page">
  <view wx:if="{{loading && !household}}" class="status"><view class="status-paws" aria-hidden="true"><image class="status-paws-img" src="/images/themes/{{themeId}}/paw-trail.svg" /></view>正在读取…</view>
  <view wx:if="{{error}}" class="notice error">{{error}}<button class="text-button" bindtap="load">再试一次</button></view>

  <block wx:if="{{household}}">
    <view wx:if="{{household.copying}}" class="notice">退出时带走的旧账还没复制完。<button class="text-button" data-page="leave" bindtap="open">继续复制</button></view>
    <view class="top-bar">
      <view class="top-greeting small muted"><image class="greet-paw" src="/images/themes/{{themeId}}/paw.svg" aria-hidden="true" />{{household.members.length > 1 ? '我们的小家' : '我的小家'}}</view>
      <view class="icon-button" data-page="settings" bindtap="open" hover-class="icon-button-active" aria-role="button" aria-label="设置">
        <image class="icon" src="/images/settings.png" mode="aspectFit" />
      </view>
    </view>

    <view wx:if="{{nudge}}" class="card nudge" aria-role="status">
      <image class="nudge-cat" src="/images/cat-icons/pet.svg" mode="aspectFit" aria-hidden="true" />
      <view class="nudge-main">
        <view class="nudge-text">{{nudge.text}}</view>
        <view class="small muted">{{nudge.sub}}{{nudgeMore ? ' · 还有 ' + nudgeMore + ' 个回应' : ''}}</view>
      </view>
      <button class="btn-small" bindtap="dismissNudge">收到啦</button>
    </view>

    <view wx:if="{{household.inviteCode}}" class="card solo">
      <view class="pair-mini" aria-hidden="true">
        <view class="avatar-sm avatar-a">{{household.members[0].name[0]}}</view>
        <view class="avatar-sm avatar-wait">TA</view>
      </view>
      <view class="solo-main">
        <view class="solo-title">先一个人用也行</view>
        <view class="small muted">想一起记时，把小家发给 TA</view>
      </view>
      <button class="solo-share" open-type="share">邀请 TA</button>
      <button class="text-button solo-copy" bindtap="copyCode">邀请码 {{household.inviteCode}}</button>
    </view>
    <view wx:else class="couple grad-card" data-page="dates" bindtap="open" aria-role="button">
      <view class="couple-names">
        <view class="avatars" aria-hidden="true">
          <view class="avatar-sm avatar-a">{{household.members[0].name[0]}}</view>
          <view class="avatar-sm avatar-b">{{household.members[1].name[0]}}</view>
        </view>
        <view class="couple-text">{{household.members[0].name}} & {{household.members[1].name}}</view>
        <view wx:if="{{together.milestoneText}}" class="couple-milestone">{{together.milestoneText}}</view>
        <view wx:if="{{together && nextHint}}" class="couple-milestone">{{nextHint}}</view>
      </view>
      <view wx:if="{{together}}" class="couple-next">
        <view class="couple-next-label">在一起第</view>
        <view class="couple-next-days">{{together.day}}<text class="couple-next-unit">天</text></view>
      </view>
      <view wx:elif="{{next}}" class="couple-next">
        <view class="couple-next-label">{{next.title}}{{next.yearly && next.years > 0 ? ' ' + next.years + ' 周年' : ''}}{{next.days === 0 ? '' : ' 还有'}}</view>
        <view wx:if="{{next.days === 0}}" class="couple-next-today">就是今天</view>
        <view wx:else class="couple-next-days">{{next.days}}<text class="couple-next-unit">天</text></view>
      </view>
    </view>

    <view wx:if="{{household.members.length > 1 && (feed.length || partnerSpent)}}" class="card recent">
      <view class="small muted recent-head">TA 最近</view>
      <view wx:if="{{partnerSpent}}" class="recent-row"><view class="recent-text">{{partnerSpent}}</view></view>
      <view wx:for="{{feed}}" wx:key="id" class="recent-row">
        <view class="recent-line">
          <view class="recent-text">{{item.text}}</view>
          <view class="small muted">{{item.when}}</view>
        </view>
        <view wx:if="{{item.canReact}}" class="chips recent-reacts">
          <view wx:for="{{reactions}}" wx:for-item="reaction" wx:key="value" class="chip {{item.mine === reaction.value ? 'chip-on' : ''}}" data-id="{{item.id}}" data-reaction="{{reaction.value}}" bindtap="react" aria-role="button" aria-label="{{reaction.label}}">{{reaction.label}}</view>
        </view>
      </view>
    </view>

    <view class="card month" data-page="ledger" bindtap="open" hover-class="card-active" aria-role="button">
      <view class="month-head">
        <view class="small muted">{{monthText}}{{household.splitting ? '共同支出' : '支出'}}</view>
        <view class="small muted">明细 <text class="chevron-sm">›</text></view>
      </view>
      <view class="month-total serif"><text wx:if="{{money.sign(spentText)}}" class="cur">¥</text>{{money.digits(spentText) || '—'}}</view>
      <view class="month-foot">
        <view class="small muted">{{countText}}</view>
        <view class="month-link small" data-page="insight" catchtap="open" hover-stop-propagation aria-role="link">花在哪儿了 <text class="chevron-sm">›</text></view>
      </view>
    </view>

    <view wx:if="{{goalsReady}}" class="card saving" data-page="goals" bindtap="open" hover-class="card-active" aria-role="button">
      <view class="month-head">
        <view class="small muted">攒钱{{goal ? ' · ' + goal.title : ''}}</view>
        <view class="small muted">{{goal ? goal.percent + '%' : '定一个目标'}} <text class="chevron-sm">›</text></view>
      </view>
      <block wx:if="{{goal}}">
        <view class="saving-track" aria-hidden="true"><view class="saving-bar {{goal.done ? 'saving-done' : ''}}" style="width: {{goal.percent}}%"></view></view>
        <view class="small {{goal.behind ? 'saving-behind' : 'muted'}}">{{goal.savedText}} / {{goal.targetText}}{{goal.monthText ? ' · ' + goal.monthText : ' · 攒够啦'}}</view>
      </block>
      <view wx:else class="small muted">比如旅行、应急金：写下金额和期限，算出每月要存多少</view>
    </view>

    <view class="actions">
      <button class="primary" bindtap="addExpense"><text class="plus">+</text>记一笔</button>
      <button class="secondary" bindtap="importBill">导入账单</button>
    </view>

    <view class="grid">
      <view class="grid-cell" data-page="lists" bindtap="open" hover-class="grid-cell-active" aria-role="button">
        <view class="tile tile-accent"><image class="tile-icon" src="/images/themes/{{themeId}}/home-lists.svg" /></view>
        <view class="grid-title">清单</view>
        <view class="small muted">{{todoText || '待办和购物'}}</view>
      </view>
      <view class="grid-cell" data-page="food" bindtap="open" hover-class="grid-cell-active" aria-role="button">
        <view class="tile tile-orange"><image class="tile-icon" src="/images/themes/{{themeId}}/home-food.svg" /></view>
        <view class="grid-title">吃啥</view>
        <view class="small muted">抽一个今天吃的</view>
      </view>
      <view class="grid-cell" data-page="wishes" bindtap="open" hover-class="grid-cell-active" aria-role="button">
        <view class="tile tile-blue"><image class="tile-icon" src="/images/themes/{{themeId}}/home-wishes.svg" /></view>
        <view class="grid-title">想去</view>
        <view class="small muted">想去的地方和想做的事</view>
      </view>
      <view wx:if="{{household.inviteCode}}" class="grid-cell" data-page="dates" bindtap="open" hover-class="grid-cell-active" aria-role="button">
        <view class="tile tile-pink"><image class="tile-icon" src="/images/themes/{{themeId}}/home-dates.svg" /></view>
        <view class="grid-title">纪念日</view>
        <view class="small muted">倒数和已经多少天</view>
      </view>
      <view wx:else class="grid-cell" data-page="footprints" bindtap="open" hover-class="grid-cell-active" aria-role="button">
        <view class="tile tile-pink"><image class="tile-icon" src="/images/themes/{{themeId}}/home-footprints.svg" /></view>
        <view class="grid-title">足迹</view>
        <view class="small muted">一起去过的地方</view>
      </view>
    </view>

    <view class="card recap" data-page="recap" bindtap="open" hover-class="card-active" aria-role="button">
      <view class="row-main">
        <view class="recap-title">我们的小报</view>
        <view class="small muted">看看上个月一起花了、吃了、做了什么</view>
      </view>
      <text class="chevron">›</text>
    </view>
  </block>
  <view class="page-end"></view>
</view>
