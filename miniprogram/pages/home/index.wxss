.top-bar { display: flex; align-items: center; justify-content: space-between; margin: -8rpx 0 16rpx; }
.top-bar .icon-button { margin-right: -12rpx; }

/* 两人都在：渐变大卡片，左边两人，右边下一个纪念日；点开进纪念 */
.couple { display: flex; align-items: flex-end; justify-content: space-between; gap: 24rpx; min-height: 220rpx; padding: 36rpx; }
.couple-names { min-width: 0; }
.couple-text { margin-top: 16rpx; font-size: 34rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.avatars { display: flex; }
.avatar-sm { width: 64rpx; height: 64rpx; border-radius: 50%; border: 4rpx solid #fff; display: flex; align-items: center; justify-content: center; font-size: 26rpx; font-weight: 700; color: #fff; }
.avatar-sm + .avatar-sm { margin-left: -16rpx; }
.couple-next { position: relative; z-index: 1; flex-shrink: 0; text-align: right; }
.couple-next-label { font-size: 24rpx; opacity: 0.92; max-width: 300rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.couple-next-days { font-size: 76rpx; font-weight: 800; line-height: 1.1; }
.couple-next-unit { font-size: 26rpx; font-weight: 600; margin-left: 6rpx; }
.couple-next-today { font-size: 40rpx; font-weight: 800; margin-top: 8rpx; }

/* 只有一个人：邀请入口，一行小卡 */
.solo { display: flex; flex-wrap: wrap; align-items: center; gap: 20rpx; padding: 28rpx 32rpx; }
.pair-mini { display: flex; flex-shrink: 0; }
.pair-mini .avatar-sm + .avatar-sm { margin-left: -16rpx; }
.avatar-wait { background: var(--sunken); color: var(--muted); border: 2rpx dashed var(--ring); }
.solo-main { flex: 1; min-width: 0; }
.solo-title { font-size: 30rpx; font-weight: 700; }
.solo-share { flex-shrink: 0; margin: 0; padding: 0 32rpx; min-height: 68rpx; line-height: 68rpx; border-radius: 34rpx; background: var(--accent-grad); color: #fff; font-size: 26rpx; font-weight: 600; }
.solo-copy { width: 100%; text-align: center; font-size: 24rpx; color: var(--muted); }

/* 本月支出：点开进记账 */
.month { margin-top: var(--gap-card); }
.card-active { background: var(--sunken); }
.month-head { display: flex; align-items: center; justify-content: space-between; }
.chevron-sm { font-size: 32rpx; }
.month-total { font-size: 64rpx; line-height: 1.3; margin: 4rpx 0; }

/* 攒钱：最要紧的一个目标 */
.saving { margin-top: var(--gap-card); padding: 28rpx 32rpx; }
.saving-track { height: 14rpx; margin: 16rpx 0 12rpx; border-radius: 7rpx; background: var(--sunken); overflow: hidden; }
.saving-bar { height: 100%; border-radius: 7rpx; background: var(--accent-grad); }
.saving-done { background: var(--ok); }
.saving-behind { color: var(--accent); }

/* 记一笔 / 截图记账 */
.actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.actions button { flex: 1; min-height: 100rpx; font-weight: 600; }

/* 四个入口 */
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gap-card) 20rpx; margin-top: var(--gap-card); }
.grid-cell { position: relative; background: var(--surface); border-radius: var(--radius); padding: 28rpx; box-shadow: var(--shadow); min-width: 0; }
.grid-cell-active { background: var(--sunken); }
.grid-title { font-size: 32rpx; font-weight: 700; margin-top: 20rpx; }
.top-greeting { display: flex; align-items: center; gap: 8rpx; }
.greet-paw { width: 28rpx; height: 28rpx; }
/* 顶上一行当页面标题：比说明文字重一档 */
.top-bar .top-greeting { font-size: 30rpx; font-weight: 600; color: var(--ink); gap: 12rpx; }
.top-bar .greet-paw { width: 32rpx; height: 32rpx; }

/* TA 最近：对方做的事，下面一排回应 */
.recent-head { margin-bottom: 8rpx; }
.recent-row { padding: 12rpx 0; }
.recent-row + .recent-row { border-top: 1rpx solid var(--line); }
.recent-line { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.recent-text { font-size: 28rpx; line-height: 1.5; min-width: 0; }
.recent-reacts { display: flex; gap: 12rpx; margin-top: 12rpx; }
.recent-chip { padding: 8rpx 24rpx; border-radius: 999rpx; border: 1rpx solid var(--line); background: var(--surface); font-size: 24rpx; color: var(--muted); }
.recent-chip-on { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); font-weight: 600; }
