.page { --poster-title-size: 58rpx; --poster-number-size: 82rpx; --arrival-gap: 24rpx; --hero-min-height: 450rpx; }
.masthead { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; padding-bottom: 28rpx; border-bottom: 1rpx solid var(--line); }
.brand { font-size: 38rpx; letter-spacing: 4rpx; }
.edition { display: flex; align-items: center; justify-content: flex-end; min-width: 112rpx; min-height: 72rpx; color: var(--accent); font-size: 25rpx; letter-spacing: 1rpx; }
.demo { margin-top: 24rpx; }

.event-poster { padding: 48rpx 0 38rpx; border-bottom: 1rpx solid var(--line); }
.poster-kicker { color: var(--accent); font-size: 23rpx; letter-spacing: 4rpx; }
.poster-title { margin-top: 18rpx; font-size: var(--poster-title-size); line-height: 1.26; letter-spacing: 1rpx; }
.countdown-block { display: flex; align-items: flex-end; gap: 20rpx; margin-top: 34rpx; }
.countdown-caption { padding-bottom: 13rpx; color: var(--accent); font-size: 25rpx; letter-spacing: 2rpx; }
.countdown-line { display: flex; align-items: baseline; color: var(--ink); line-height: 1; }
.countdown-number { font-size: var(--poster-number-size); letter-spacing: -2rpx; }
.countdown-unit { margin-left: 11rpx; font-size: 28rpx; letter-spacing: 2rpx; }
.poster-meta { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 30rpx; color: var(--muted); font-size: 27rpx; line-height: 1.5; }
.poster-dot { color: var(--accent); }

.arrival-strip { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; column-gap: var(--arrival-gap); width: 100%; min-height: 112rpx; margin-top: 18rpx; padding: 20rpx 0 18rpx; border-top: 1rpx solid var(--line); border-bottom: 1rpx solid var(--line); }
.arrival-strip-active { opacity: .66; }
.arrival-static { display: block; }
.arrival-venue { display: -webkit-box; overflow: hidden; color: var(--ink); font-size: 31rpx; line-height: 1.45; text-align: left; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.arrival-action { display: flex; align-items: center; gap: 10rpx; padding: 14rpx 0 14rpx 12rpx; color: var(--accent); font-size: 22rpx; letter-spacing: 2rpx; }
.direction-chevron { flex: 0 0 auto; width: 12rpx; height: 12rpx; border-top: 2rpx solid currentColor; border-right: 2rpx solid currentColor; transform: rotate(45deg); }
.nav-chevron { margin-right: 5rpx; }

.photo-cta { width: 100%; min-height: 94rpx; margin-top: 30rpx; letter-spacing: 1rpx; }
.blessing-cta { display: block; min-height: 76rpx; padding: 22rpx 0 10rpx; color: var(--accent); font-size: 27rpx; line-height: 1.5; text-align: center; }
.memory-intro { padding: 48rpx 0 30rpx; }
.memory-title { margin-top: 16rpx; font-size: 62rpx; line-height: 1.22; }
.memory-lead { margin-top: 16rpx; color: var(--muted); font-size: 28rpx; }
.photo-opening { padding-top: 46rpx; }
.hero { margin-top: 20rpx; }
.hero-pending { min-height: var(--hero-min-height); margin-top: 20rpx; border: 1rpx solid var(--line); background: #f3eadc; }
.photo-label { margin-top: 16rpx; color: var(--muted); font-size: 21rpx; letter-spacing: 4rpx; }
.after-photo-cta { margin-top: 30rpx; }

.secondary-navigation { margin-top: 58rpx; }
.nav-row { display: grid; grid-template-columns: 46rpx minmax(0, 1fr) 28rpx; align-items: center; column-gap: 20rpx; min-height: 132rpx; border-bottom: 1rpx solid var(--line); color: var(--ink); }
.nav-number { color: var(--accent); font-family: 'Songti SC', STSong, SimSun, serif; font-size: 26rpx; }
.nav-copy { min-width: 0; }
.nav-title { font-size: 39rpx; line-height: 1.2; }
.nav-arrow { color: var(--accent); }
.cat-note { display: flex; justify-content: space-between; width: 100%; margin: 56rpx 0 0; padding: 30rpx 0; color: var(--accent); text-align: left; border-top: 1rpx solid var(--line); border-bottom: 1rpx solid var(--line); border-radius: 0; }
.cat-reveal { padding: 30rpx 0 8rpx; }
.cat-photos { display: flex; gap: 22rpx; margin-top: 28rpx; }
.cat-column { flex: 1; min-width: 0; }
.cat-photo { margin-bottom: 30rpx; }
.cat-caption { padding-top: 12rpx; color: var(--muted); font-size: 23rpx; }
.cat-description { padding-top: 4rpx; color: var(--muted); font-size: 21rpx; }
.entrance .event-poster, .entrance .photo-opening { animation: appear 520ms ease both; }
.entrance .photo-opening { animation-delay: 80ms; }
@media (max-width: 340px) { .page { --poster-title-size: 50rpx; --poster-number-size: 72rpx; --arrival-gap: 16rpx; } .event-poster { padding-top: 38rpx; } .arrival-venue { font-size: 29rpx; } .nav-title { font-size: 35rpx; } }