<view class="page">
  <block wx:if="{{id}}">
    <view class="field"><text class="field-label">名字</text><input value="{{name}}" maxlength="{{limits.dishName}}" bindinput="inputName" placeholder="菜名或店名" /></view>
    <view class="field">
      <text class="field-label">怎么吃</text>
      <view class="segmented"><view wx:for="{{tags}}" wx:key="value" class="segment {{tag === item.value ? 'segment-on' : ''}}" data-value="{{item.value}}" bindtap="chooseTag">{{item.label}}</view></view>
    </view>
    <view wx:if="{{ateOn}}" class="small muted ate">上次吃：{{ateOn}}</view>
  </block>
  <view wx:if="{{error}}" class="notice error">{{error}}</view>
  <block wx:if="{{id}}">
    <button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存</button>
    <button class="danger-button" bindtap="remove" disabled="{{busy}}">从菜单删除</button>
  </block>
</view>
