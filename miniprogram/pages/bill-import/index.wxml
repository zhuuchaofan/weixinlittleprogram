<page-meta page-style="{{themeStyle}}" />
<view class="page">
  <view wx:if="{{phase === 'reading'}}" class="waiting" aria-label="{{progressText}}">
    <!-- 等待动画：线条小猫守着一杯冒热气的茶，摇尾巴、眨眼。轮廓是 images 里的 SVG，动作用 CSS。 -->
    <view class="scene" aria-hidden="true">
      <view class="cat">
        <image class="tail" src="/images/themes/{{themeId}}/cat-tail.svg" />
        <image class="cat-outline" src="/images/themes/{{themeId}}/cat.svg" />
        <view class="eye eye-left"></view>
        <view class="eye eye-right"></view>
      </view>
      <image class="steam steam-1" src="/images/themes/{{themeId}}/steam.svg" />
      <image class="steam steam-2" src="/images/themes/{{themeId}}/steam.svg" />
      <image class="steam steam-3" src="/images/themes/{{themeId}}/steam.svg" />
      <image class="cup" src="/images/themes/{{themeId}}/cup.svg" />
    </view>
    <view class="waiting-text">{{progressText}}</view>
    <view class="small muted waiting-tip">{{tip}}</view>
  </view>

  <block wx:elif="{{phase === 'empty'}}">
    <view class="empty">{{error || '截图里没有读到账目。'}}</view>
    <view wx:for="{{failures}}" wx:key="*this" class="notice error">{{item}}</view>
    <button wx:if="{{limitHit}}" class="text-button" bindtap="openVip">看看会员</button>
    <view wx:if="{{mode === 'file'}}" class="small muted hint">微信：我 → 服务 → 钱包 → 账单 → 右上角「…」→ 下载账单 → 用于个人对账，微信支付会发来「账单流水文件」通知，点「查看详情」打开文件，发送给「文件传输助手」，再从文件传输助手里选这个文件。</view>
    <view wx:else class="small muted hint">请选微信「账单」或支付宝「账单」的列表页截图，文字清楚、不要裁掉日期。</view>
    <button class="secondary back-button" bindtap="back">返回记账</button>
  </block>

  <block wx:else>
    <view class="notice">{{summaryText}}。导入的账都记在你名下。<text wx:if="{{skippedText}}">{{skippedText}}</text></view>
    <view wx:for="{{failures}}" wx:key="*this" class="notice error">{{item}}</view>
    <button wx:if="{{limitHit}}" class="text-button" bindtap="openVip">看看会员</button>

    <block wx:if="{{months.length}}">
      <scroll-view class="months" scroll-x enhanced show-scrollbar="{{false}}">
        <view wx:for="{{months}}" wx:key="month" class="chip {{item.month === month ? 'chip-on' : ''}}" data-month="{{item.month}}" bindtap="chooseMonth">{{item.label}} {{item.count}}</view>
      </scroll-view>
      <view class="month-actions small">
        <text class="month-link" data-on="{{true}}" bindtap="selectMonth">本月全选</text>
        <text class="month-link" data-on="{{false}}" bindtap="selectMonth">本月全不选</text>
      </view>
    </block>

    <draft-list rows="{{rows}}" today="{{today}}" bind:change="changeRows" />

    <view wx:if="{{error}}" class="notice error">{{error}}</view>
    <view class="save-bar">
      <button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy || !selectedCount}}">{{saveText || '保存选中的 ' + selectedCount + ' 笔'}}</button>
    </view>
  </block>
  <view class="page-end"></view>
</view>
