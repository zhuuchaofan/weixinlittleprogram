.hint { margin: 24rpx 4rpx; }
.back-button { margin-top: 24rpx; }
.bill { background: var(--surface); border: 1rpx solid var(--line); border-radius: var(--radius); overflow: hidden; margin-bottom: 16rpx; }
.bill-off .row-title, .bill-off .amount { color: var(--muted); }
.bill-head { display: flex; align-items: center; gap: 20rpx; min-height: 112rpx; padding: 20rpx 28rpx; }
.check { width: 48rpx; height: 48rpx; flex-shrink: 0; border-radius: 12rpx; border: 2rpx solid var(--line); display: flex; align-items: center; justify-content: center; color: #fff9ee; font-size: 28rpx; }
.check-on { background: var(--accent); border-color: var(--accent); }
.amount { font-size: 34rpx; }
.income { color: var(--ok); }
.warn { color: #9a6a1f; }
.flag { padding: 0 28rpx 20rpx 96rpx; font-size: 24rpx; color: var(--accent); }
.flag-bad { color: #a23b33; }
.editor { padding: 24rpx 28rpx 8rpx; border-top: 1rpx solid var(--line); background: var(--paper); }
.editor .segmented { margin-bottom: 24rpx; }
.save-bar { position: sticky; bottom: 0; padding: 20rpx 0 calc(20rpx + env(safe-area-inset-bottom)); background: var(--paper); }

/* 等待动画：线条小猫，只画轮廓 */
.waiting { padding: 96rpx 0 48rpx; display: flex; flex-direction: column; align-items: center; }
.scene { position: relative; width: 360rpx; height: 260rpx; }
.cat { position: absolute; left: 20rpx; bottom: 0; width: 200rpx; height: 240rpx; }
.body { position: absolute; left: 30rpx; bottom: 0; width: 140rpx; height: 130rpx; border-radius: 70rpx 70rpx 24rpx 24rpx; border: 4rpx solid var(--accent); background: var(--paper); }
.head { position: absolute; left: 40rpx; bottom: 110rpx; width: 120rpx; height: 104rpx; border-radius: 50%; border: 4rpx solid var(--accent); background: var(--paper); animation: nod 3.2s ease-in-out infinite; }
.ear { position: absolute; top: -12rpx; width: 36rpx; height: 36rpx; border-top: 4rpx solid var(--accent); border-left: 4rpx solid var(--accent); background: var(--paper); border-radius: 6rpx 0 0 0; transform: rotate(45deg); }
.ear-left { left: 12rpx; transform: rotate(25deg); }
.ear-right { right: 12rpx; transform: rotate(65deg); }
.eye { position: absolute; top: 44rpx; width: 10rpx; height: 14rpx; border-radius: 50%; background: var(--accent); animation: blink 4s infinite; }
.eye-left { left: 32rpx; }
.eye-right { right: 32rpx; }
.nose { position: absolute; top: 64rpx; left: 50rpx; width: 12rpx; height: 8rpx; border-radius: 0 0 8rpx 8rpx; background: var(--accent); }
.tail { position: absolute; left: -40rpx; bottom: 10rpx; width: 80rpx; height: 50rpx; border: 4rpx solid var(--accent); border-color: transparent transparent var(--accent) var(--accent); border-radius: 0 0 0 50rpx; transform-origin: 100% 100%; animation: wag 1.2s ease-in-out infinite; }
.cup { position: absolute; right: 30rpx; bottom: 0; width: 84rpx; height: 70rpx; border-radius: 6rpx 6rpx 30rpx 30rpx; border: 4rpx solid var(--accent); }
.handle { position: absolute; right: -30rpx; top: 10rpx; width: 26rpx; height: 32rpx; border: 4rpx solid var(--accent); border-left: 0; border-radius: 0 20rpx 20rpx 0; }
.steam { position: absolute; bottom: 80rpx; width: 4rpx; height: 40rpx; border-radius: 2rpx; background: var(--accent); opacity: 0; animation: steam 2.4s ease-out infinite; }
.steam-1 { left: 18rpx; }
.steam-2 { left: 38rpx; animation-delay: 0.8s; }
.steam-3 { left: 58rpx; animation-delay: 1.6s; }
.waiting-text { margin-top: 40rpx; font-size: 28rpx; }
.waiting-tip { margin-top: 12rpx; }
@keyframes wag { 0%, 100% { transform: rotate(-12deg); } 50% { transform: rotate(14deg); } }
@keyframes blink { 0%, 92%, 100% { transform: scaleY(1); } 96% { transform: scaleY(0.1); } }
@keyframes nod { 0%, 100% { transform: rotate(0); } 50% { transform: rotate(-4deg); } }
@keyframes steam { 0% { opacity: 0; transform: translateY(0) scaleY(0.6); } 30% { opacity: 0.5; } 100% { opacity: 0; transform: translateY(-50rpx) scaleY(1.1); } }
