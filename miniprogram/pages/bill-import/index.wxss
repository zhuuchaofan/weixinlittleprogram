.hint { margin: 24rpx 4rpx; }
button.back-button:not([size='mini']) { margin-top: 24rpx; }
.months { white-space: nowrap; margin: 8rpx 0 4rpx; }
.months .chip { display: inline-flex; margin-right: 12rpx; }
.month-actions { display: flex; gap: 32rpx; justify-content: flex-end; margin: 8rpx 4rpx 16rpx; }
.month-link { color: var(--accent); }
.save-bar { position: sticky; bottom: 0; padding: 20rpx 0 calc(20rpx + env(safe-area-inset-bottom)); background: var(--paper); }

/* 等待动画：线条小猫，轮廓见 assets/theme-src/cat.svg 等（按主题换色后在 images/themes/） */
.waiting { padding: 96rpx 0 48rpx; display: flex; flex-direction: column; align-items: center; }
.scene { position: relative; width: 440rpx; height: 260rpx; }
.cat { position: absolute; left: 30rpx; bottom: 0; width: 240rpx; height: 240rpx; }
.cat-outline { position: absolute; left: 0; top: 0; width: 240rpx; height: 240rpx; }
.tail { position: absolute; left: 180rpx; top: 128rpx; width: 84rpx; height: 108rpx; transform-origin: 7% 94%; animation: wag 1.4s ease-in-out infinite; }
.eye { position: absolute; top: 76rpx; width: 12rpx; height: 16rpx; border-radius: 50%; background: var(--ink); animation: blink 4s infinite; }
.eye-left { left: 92rpx; }
.eye-right { left: 136rpx; }
.cup { position: absolute; right: 20rpx; bottom: 0; width: 132rpx; height: 88rpx; }
.steam { position: absolute; bottom: 92rpx; width: 22rpx; height: 66rpx; opacity: 0; animation: steam 2.4s ease-out infinite; }
.steam-1 { right: 104rpx; }
.steam-2 { right: 78rpx; animation-delay: 0.8s; }
.steam-3 { right: 52rpx; animation-delay: 1.6s; }
.waiting-text { margin-top: 40rpx; font-size: 28rpx; }
.waiting-tip { margin-top: 12rpx; }
@keyframes wag { 0%, 100% { transform: rotate(-8deg); } 50% { transform: rotate(10deg); } }
@keyframes blink { 0%, 92%, 100% { transform: scaleY(1); } 96% { transform: scaleY(0.1); } }
@keyframes steam { 0% { opacity: 0; transform: translateY(10rpx); } 30% { opacity: 0.6; } 100% { opacity: 0; transform: translateY(-30rpx); } }
