<page-meta page-style="{{themeStyle}}" />
<view class="page">
  <view wx:if="{{isSettlement}}" class="card">
    <view class="section-title">结算记录</view>
    <view class="muted settle-text">{{names[payer]}} 付给对方 {{settleText}}。结算记录不能修改，删除即可撤销这次结算。</view>
  </view>
  <block wx:else>
    <view class="segmented flow-switch">
      <view wx:for="{{flows}}" wx:key="value" class="segment {{flow === item.value ? 'segment-on' : ''}}" data-field="flow" data-value="{{item.value}}" bindtap="choose" aria-role="button">{{item.label}}</view>
    </view>
    <view class="amount-box">
      <text class="yen">¥</text>
      <input class="amount-input" type="digit" value="{{amountText}}" placeholder="0.00" bindinput="inputAmount" focus="{{!id}}" />
    </view>
    <view class="field">
      <text class="field-label">分类</text>
      <view class="cat-grid">
        <view wx:for="{{categories}}" wx:key="name" class="cat-cell {{cat === item.name ? 'cat-cell-on' : ''}}" data-field="cat" data-value="{{item.name}}" bindtap="choose" aria-role="button" aria-label="{{item.name}}">
          <view class="tile" style="background: {{item.tint}}"><image class="tile-icon" src="{{item.icon}}" /></view>
          <view class="cat-cell-name">{{item.name}}</view>
        </view>
      </view>
    </view>
    <view class="field">
      <text class="field-label">备注</text>
      <input value="{{note}}" maxlength="{{limits.expenseNote}}" placeholder="可不填" bindinput="inputNote" />
    </view>
    <view class="field">
      <text class="field-label">日期</text>
      <picker mode="date" value="{{date}}" end="{{today}}" bindchange="pickDate"><view class="picker-value">{{date}}</view></picker>
    </view>
    <view class="field">
      <text class="field-label">{{flow === 'in' ? '谁收的' : '谁付的'}}</text>
      <view class="chips chips-fill">
        <view class="chip {{payer === 'a' ? 'chip-on' : ''}}" data-field="payer" data-value="a" bindtap="choose">{{names.a}}</view>
        <view class="chip {{payer === 'b' ? 'chip-on' : ''}}" data-field="payer" data-value="b" bindtap="choose">{{names.b}}</view>
      </view>
    </view>
    <view wx:if="{{flow === 'in' && splitting}}" class="small muted field">收入只记在自己名下，不参与两人分摊。</view>
    <view wx:elif="{{flow === 'out' && splitting}}" class="field">
      <text class="field-label">怎么分</text>
      <view class="list">
        <view wx:for="{{splits}}" wx:key="value" class="list-row" data-field="split" data-value="{{item.value}}" bindtap="choose" hover-class="list-row-active">
          <view class="radio {{split === item.value ? 'radio-on' : ''}}"></view>
          <view class="row-main"><view>{{item.label}}</view><view class="row-sub">{{item.hint}}</view></view>
        </view>
      </view>
    </view>
    <view wx:if="{{splitting && flow === 'out' && split === 'ratio'}}" class="field">
      <text class="field-label">付款人承担（%）</text>
      <input type="number" maxlength="3" value="{{ratioText}}" placeholder="例如 60，表示 6:4" bindinput="inputRatio" />
      <view wx:if="{{ratioHint}}" class="row-sub ratio-hint">{{ratioHint}}</view>
    </view>
    <view wx:if="{{error}}" class="notice error">{{error}}</view>
    <button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存</button>
  </block>
  <view wx:if="{{isSettlement && error}}" class="notice error">{{error}}</view>
  <view wx:if="{{recordedText}}" class="recorded small muted">{{recordedText}}</view>
  <view wx:if="{{sourceText}}" class="small muted edited">{{sourceText}}</view>
  <view wx:if="{{editedText}}" class="small muted edited">{{editedText}}</view>
  <button wx:if="{{id}}" class="danger-button" bindtap="remove" disabled="{{busy}}">{{isSettlement ? '删除并撤销结算' : '删除这笔账'}}</button>
  <view class="page-end"></view>
</view>
