<view class="page">
  <view wx:if="{{isSettlement}}" class="notice">这是一条结算记录（{{names[payer]}} 付给对方 ¥{{amountText}}）。结算记录不能修改，删除即可撤销这次结算。</view>
  <block wx:else>
    <view class="field">
      <text class="field-label">金额（日元）</text>
      <input class="amount-input serif" type="number" value="{{amountText}}" placeholder="0" bindinput="inputAmount" focus="{{!id}}" />
    </view>
    <view class="field">
      <text class="field-label">分类</text>
      <view class="chips">
        <view wx:for="{{categories}}" wx:key="*this" class="chip {{cat === item ? 'chip-on' : ''}}" data-field="cat" data-value="{{item}}" bindtap="choose">{{item}}</view>
      </view>
    </view>
    <view class="field">
      <text class="field-label">备注</text>
      <input value="{{note}}" maxlength="40" placeholder="可不填" bindinput="inputNote" />
    </view>
    <view class="field">
      <text class="field-label">日期</text>
      <picker mode="date" value="{{date}}" bindchange="pickDate"><view class="picker-value">{{date}}</view></picker>
    </view>
    <view class="field">
      <text class="field-label">谁付的</text>
      <view class="chips">
        <view class="chip chip-wide {{payer === 'a' ? 'chip-on' : ''}}" data-field="payer" data-value="a" bindtap="choose">{{names.a}}</view>
        <view class="chip chip-wide {{payer === 'b' ? 'chip-on' : ''}}" data-field="payer" data-value="b" bindtap="choose">{{names.b}}</view>
      </view>
    </view>
    <view class="field">
      <text class="field-label">怎么分</text>
      <view wx:for="{{splits}}" wx:key="value" class="split {{split === item.value ? 'split-on' : ''}}" data-field="split" data-value="{{item.value}}" bindtap="choose">
        <view>{{item.label}}</view><view class="small muted">{{item.hint}}</view>
      </view>
    </view>
    <view wx:if="{{error}}" class="notice error">{{error}}</view>
    <button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存</button>
  </block>
  <view wx:if="{{isSettlement && error}}" class="notice error">{{error}}</view>
  <button wx:if="{{id}}" class="text-button delete-button" bindtap="remove" disabled="{{busy}}">{{isSettlement ? '删除并撤销结算' : '删除这笔账'}}</button>
  <view class="bottom-space"></view>
</view>
