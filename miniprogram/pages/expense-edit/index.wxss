.amount-box { display: flex; align-items: center; gap: 12rpx; padding: 16rpx 32rpx; margin-bottom: 32rpx; border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); }
.yen { font-size: 56rpx; font-weight: 700; color: var(--accent); }
.amount-input { flex: 1; height: 112rpx; font-size: 72rpx; font-weight: 700; border: 0; background: transparent; padding: 0; box-shadow: none; }
.radio { width: 40rpx; height: 40rpx; flex-shrink: 0; border-radius: 50%; border: 2rpx solid var(--line); }
.radio-on { border: 12rpx solid var(--accent); }
.settle-text { margin-top: 12rpx; }
.recorded { text-align: center; margin-top: 32rpx; }
.edited { text-align: center; margin-top: 8rpx; }
.ratio-hint { margin-top: 12rpx; }
.flow-switch { margin-bottom: 24rpx; }
.cat-grid { display: flex; flex-wrap: wrap; margin: -6rpx; }
.cat-cell { width: calc(20% - 12rpx); margin: 6rpx; display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 16rpx 0 12rpx; border-radius: var(--radius-sm); border: 2rpx solid transparent; }
.cat-cell-on { background: var(--surface); border-color: var(--accent); box-shadow: var(--shadow); }
.cat-cell-name { font-size: 24rpx; white-space: nowrap; }
.cat-cell-on .cat-cell-name { color: var(--accent); font-weight: 600; }
