.amount-box { display: flex; align-items: center; gap: 12rpx; padding: 12rpx 0 24rpx; margin-bottom: 32rpx; border-bottom: 2rpx solid var(--accent); }
.yen { font-size: 56rpx; color: var(--accent); }
.amount-input { flex: 1; height: 112rpx; font-size: 72rpx; border: 0; background: transparent; padding: 0; }
.radio { width: 40rpx; height: 40rpx; flex-shrink: 0; border-radius: 50%; border: 2rpx solid var(--line); }
.radio-on { border: 12rpx solid var(--accent); }
.settle-text { margin-top: 12rpx; }
.recorded { text-align: center; margin-top: 32rpx; }
.ratio-hint { margin-top: 12rpx; }
