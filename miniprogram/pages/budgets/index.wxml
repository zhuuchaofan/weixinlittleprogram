<page-meta page-style="{{themeStyle}}" />
<view class="page">
  <view class="small muted lead-note">给想控制的几类填每月上限，其余空着。记账时这一类花到 80% 或超出会提醒一下；记账页的分类统计里能看到用了多少。按所有支出算，两个人共用。</view>
  <view wx:if="{{loading}}" class="status">正在读取…</view>
  <view wx:elif="{{!rows.length && error}}" class="notice error">{{error}}</view>
  <form wx:if="{{!loading && rows.length}}" bindsubmit="save">
  <view class="list">
    <view wx:for="{{rows}}" wx:key="cat" class="list-row budget-row">
      <view class="cat-dot" style="background: {{item.color}}"></view>
      <view class="row-main">
        <view class="row-title">{{item.cat}}</view>
        <view wx:if="{{item.hint}}" class="row-sub">{{item.hint}}</view>
      </view>
      <view class="budget-input-box">
        <text class="muted">¥</text>
        <input class="budget-input" name="{{item.cat}}" type="digit" value="{{item.value}}" data-index="{{index}}" bindinput="input" placeholder="不设" aria-label="{{item.cat}}每月预算" />
      </view>
    </view>
  </view>
  <view wx:if="{{error}}" class="notice error">{{error}}</view>
  <button class="primary save" form-type="submit" loading="{{busy}}" disabled="{{busy}}">保存</button>
  </form>
</view>
