<view class="page"><view class="kicker">{{copy.text01}}</view><view class="title">{{copy.text02}}</view><view class="lead">{{appConfig.brand}} {{copy.text03}}</view>
  <view class="notice">{{isMock ? copy.text04 : copy.text05}}</view>
  <view class="section"><view class="section-title">{{copy.text06}}</view><view>{{copy.text07}}</view></view>
  <view class="section"><view class="section-title">{{copy.text08}}</view><view>{{copy.text09}}</view></view>
  <view class="section"><view class="section-title">{{copy.text10}}</view><view>{{copy.text11}}</view></view>
  <view class="section"><view class="section-title">{{copy.photosTitle}}</view><view>{{copy.photosBody}}</view><view class="section-contact">{{copy.photosVisibility}}</view><view>{{copy.photosRemoval}}</view></view>
  <view class="section"><view class="section-title">{{copy.text12}}</view><view>{{appConfig.retention}}</view><view class="section-contact">联系方式：{{appConfig.privacyContact.channel}} {{appConfig.privacyContact.account}}</view><view class="small muted">{{copy.text13}}</view><button class="text-button" bindtap="openPlatformGuide">{{copy.platformGuide}} ↗</button></view>
  <view class="section"><view class="inline"><view><view>{{copy.text14}}</view><view class="small muted">{{copy.text15}}</view></view><switch checked="{{reduceMotion}}" bindchange="motion" color="#783e3c" aria-label="{{copy.text14}}" /></view></view>
  <view wx:if="{{message}}" class="notice">{{message}}</view><view wx:if="{{error}}" class="notice error">{{error}}</view>
  <view class="section"><button class="secondary" bindtap="remove" loading="{{busy}}" disabled="{{busy}}">{{isMock ? copy.text16 : copy.text17}}</button></view><view class="section"><navigator class="text-button" url="/pages/rsvp/index">查看我的登记</navigator><navigator class="text-button" url="/pages/guestbook/index">查看或删除我的祝福</navigator></view><page-footer />
</view>
