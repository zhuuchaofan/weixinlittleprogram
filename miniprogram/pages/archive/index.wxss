.stats { display: flex; margin-top: 32rpx; padding: 28rpx 12rpx; }
.stat-item { flex: 1; min-width: 0; text-align: center; }
.stat-item + .stat-item { border-left: 1rpx solid var(--line); }
.stat { font-size: 60rpx; color: var(--accent); line-height: 1.3; }
.message { margin-bottom: 20rpx; }
.message + .message { margin-top: 0; }
.message-text { white-space: pre-wrap; font-size: 30rpx; margin-bottom: 16rpx; }
.rsvp-row { align-items: flex-start; }
.rsvp-note { margin: 8rpx 0; white-space: pre-wrap; font-size: 28rpx; }
