<view class="page">
  <view wx:if="{{aiEnabled}}" class="ai-block">
    <view class="section-head"><view class="section-title">让 AI 出主意</view></view>
    <view class="card">
      <view wx:for="{{groups}}" wx:key="key" wx:for-item="group" class="field">
        <text class="field-label">{{group.label}}</text>
        <view class="chips">
          <view wx:for="{{conditions[group.key]}}" wx:key="*this" class="chip {{picked[group.key] === item ? 'chip-on' : ''}}" data-field="{{group.key}}" data-value="{{item}}" bindtap="pick">{{item}}</view>
        </view>
      </view>
      <button class="secondary" bindtap="askAi" loading="{{aiBusy}}" disabled="{{aiBusy}}">让 AI 推荐</button>
    </view>
    <view wx:if="{{aiItems.length}}" class="list list-gap">
      <view wx:for="{{aiItems}}" wx:key="title" class="list-row">
        <view class="row-main"><view class="row-title">{{item.title}}</view><view class="row-sub">{{item.why}}</view><view wx:if="{{item.plan || item.cost}}" class="row-sub">{{item.plan}} {{item.cost}}</view></view>
        <button class="text-button" data-index="{{index}}" bindtap="keepAi">收藏</button>
      </view>
    </view>
  </view>

  <view class="section-head {{aiEnabled ? 'section' : ''}}">
    <view class="section-title">想去的地方</view>
    <button class="primary btn-inline" bindtap="add">添加</button>
  </view>
  <view wx:if="{{error}}" class="notice error">{{error}}<button class="text-button" bindtap="load">刷新</button></view>
  <view wx:if="{{loading && !wishes.length}}" class="status">正在读取…</view>
  <view wx:elif="{{!wishes.length}}" class="empty">还没有收藏。周末想去哪儿，先记下来。</view>
  <view wx:else class="list">
    <view wx:for="{{wishes}}" wx:key="id" class="list-row" data-id="{{item.id}}" bindtap="open" hover-class="list-row-active">
      <view class="row-main">
        <view class="wish-title serif">{{item.title}}</view>
        <view wx:if="{{item.why}}" class="row-sub">{{item.why}}</view>
        <view wx:if="{{item.plan}}" class="wish-plan">{{item.plan}}</view>
      </view>
      <text class="chevron">›</text>
    </view>
  </view>
  <view class="page-end"></view>
</view>
