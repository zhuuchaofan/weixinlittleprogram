<page-meta page-style="{{themeStyle}}" />
<view class="page">
  <view class="hero">
    <view class="home-tile"><image class="home-icon" src="/images/ui/cat-face.svg" /></view>
    <view class="title">喵喵记一笔</view>
    <view class="lead">记账、清单、吃啥、想去和纪念日。一个人先用也行，想一起记时再邀请 TA。</view>
    <view class="pair" aria-hidden="true">
      <view class="avatar-lg avatar-a">我</view>
      <view class="pair-line"></view>
      <view class="pair-heart"><image class="pair-heart-icon" src="/images/ui/heart.svg" /></view>
      <view class="pair-line"></view>
      <view class="avatar-lg avatar-b">TA</view>
    </view>
  </view>
  <view wx:if="{{checking}}" class="status"><view class="status-paws" aria-hidden="true"><image class="status-paws-img" src="/images/themes/{{themeId}}/paw-trail.svg" /></view>正在确认…</view>
  <view wx:elif="{{mode === 'choose'}}" class="stack">
    <button class="primary" data-mode="create" bindtap="choose">创建小家</button>
    <button class="secondary" data-mode="join" bindtap="choose">用邀请码加入</button>
  </view>
  <view wx:elif="{{mode === 'occupied'}}">
    <view class="card">
      <view class="section-title">你已经在一个小家里了</view>
      <view wx:if="{{alone}}" class="rule">· 要加入新小家，得先退出现在的小家。你的小家现在只有你一个人，退出会清空里面的全部记录，删了找不回来。</view>
      <block wx:else>
        <view class="rule">· 你现在和{{partner}}在一个小家里。要加入新小家，得先退出。</view>
        <view class="rule">· 第一次退出会带着副本去一个只有你的新小家，{{partner}}那边不动；再从新小家退出一次（会清空里面的记录），才能加入。</view>
      </block>
      <view class="rule">· 邀请码 {{code}} 已经记下了，退出后回到这里会自动填好。</view>
    </view>
    <view class="stack occupied-actions">
      <button class="primary" bindtap="stay">留在现在的小家</button>
      <button class="secondary" bindtap="toLeave">看看怎么退出</button>
    </view>
  </view>
  <view wx:else class="card">
    <view class="section-title form-title">{{mode === 'create' ? '创建小家' : '加入小家'}}</view>
    <view class="field">
      <text class="field-label">我的称呼</text>
      <input value="{{name}}" maxlength="12" placeholder="对方会看到这个称呼，例如：小猪" bindinput="inputName" />
    </view>
    <view wx:if="{{mode === 'join'}}" class="field">
      <text class="field-label">邀请码</text>
      <input class="code-input" value="{{code}}" maxlength="6" placeholder="6 位，对方在主页可以看到" bindinput="inputCode" />
    </view>
    <button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{mode === 'create' ? '创建' : '加入'}}</button>
    <button class="text-button back" data-mode="choose" bindtap="choose">返回</button>
  </view>
  <view wx:if="{{error}}" class="notice error">{{error}}</view>
</view>
