.hero { padding: 48rpx 0 56rpx; text-align: center; display: flex; flex-direction: column; align-items: center; }
.home-tile { width: 160rpx; height: 160rpx; border-radius: 44rpx; background: var(--accent-grad); display: flex; align-items: center; justify-content: center; box-shadow: 0 16rpx 40rpx var(--glow); margin-bottom: 32rpx; }
.home-icon { width: 88rpx; height: 88rpx; }
.hero .title { margin: 0 0 12rpx; }
.pair { display: flex; align-items: center; justify-content: center; margin-top: 48rpx; }
.avatar-lg { width: 120rpx; height: 120rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 38rpx; font-weight: 700; box-shadow: 0 8rpx 24rpx var(--tint); }
.pair-line { width: 48rpx; border-top: 4rpx dashed var(--ring); }
.pair-heart { width: 60rpx; height: 60rpx; border-radius: 50%; background: var(--accent-grad); display: flex; align-items: center; justify-content: center; }
.pair-heart-icon { width: 32rpx; height: 32rpx; }
.form-title { margin-bottom: 24rpx; }
.code-input { letter-spacing: 8rpx; }
.rule { margin-top: var(--gap-sm); font-size: 28rpx; line-height: 1.7; }
.occupied-actions { margin-top: var(--gap-lg); }
button.back:not([size='mini']) { margin: 12rpx auto 0; }
/* 小猫图标轻轻浮着，中间的心在跳 */
.home-tile { animation: float 3.6s ease-in-out infinite; }
.pair-heart { animation: beat 1.6s ease-in-out infinite; }
@keyframes float { 0%, 100% { transform: none; } 50% { transform: translateY(-10rpx); } }
@keyframes beat { 0%, 60%, 100% { transform: none; } 15% { transform: scale(1.18); } 30% { transform: scale(0.96); } 45% { transform: scale(1.08); } }
@media (prefers-reduced-motion: reduce) { .home-tile, .pair-heart { animation: none; } }
