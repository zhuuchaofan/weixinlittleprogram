.hero { padding: 36rpx 36rpx 32rpx; }
.hero-label { font-size: 24rpx; opacity: 0.92; }
.hero-total { font-size: 80rpx; font-weight: 800; line-height: 1.2; margin: 8rpx 0 12rpx; letter-spacing: -1rpx; }
.hero-change { font-size: 28rpx; font-weight: 600; }
.hero-income { margin-top: 8rpx; font-size: 24rpx; opacity: 0.92; }

.section-head { margin-top: 32rpx; }

/* 喵喵小结 */
.ai { margin-top: 24rpx; }
.ai-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.ai-cat { width: 44rpx; height: 44rpx; }
.ai-title { font-size: 30rpx; font-weight: 700; }
.ai-disclaimer { margin-top: 8rpx; }
.ai-text { font-size: 28rpx; line-height: 1.8; white-space: pre-line; }
.ai-error { margin-top: 12rpx; color: var(--danger); }
.ai-foot { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 16rpx; }

/* 按分类对比：每类一行文字 + 一条按本月最大一类缩放的进度条 */
.compare { padding: 20rpx 32rpx; }
.compare-row { padding: 12rpx 0; }
.compare-line { display: flex; align-items: center; gap: 16rpx; min-height: 56rpx; }
.cat-name { flex: 1; min-width: 0; font-size: 28rpx; white-space: nowrap; }
.compare-change { flex-shrink: 0; color: var(--muted); white-space: nowrap; }
.compare-change.up { color: var(--accent); }
.compare-change.down { color: var(--ok); }
.cat-amount { width: 170rpx; flex-shrink: 0; text-align: right; font-size: 28rpx; font-weight: 600; white-space: nowrap; }
.compare-track { height: 10rpx; margin-left: 32rpx; border-radius: 5rpx; background: var(--sunken); overflow: hidden; }
.compare-bar { height: 100%; border-radius: 5rpx; }

.big-amount { font-size: 32rpx; }

/* 近 6 个月：竖条，本月用主色 */
.trend { display: flex; align-items: flex-end; gap: 12rpx; padding: 28rpx 24rpx 20rpx; }
.trend-col { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; }
.trend-value { font-size: 18rpx; white-space: nowrap; height: 32rpx; }
.trend-track { width: 100%; height: 200rpx; display: flex; align-items: flex-end; justify-content: center; }
.trend-bar { width: 56%; border-radius: 10rpx 10rpx 4rpx 4rpx; background: var(--ring); }
.trend-current { background: var(--accent); }
.trend-label { margin-top: 8rpx; }

.page-end { height: 80rpx; }
