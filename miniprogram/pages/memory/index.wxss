.shots { height: 640rpx; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); background: var(--accent-soft); }
.shot { display: block; width: 100%; height: 100%; }
.story { margin-top: var(--gap-card); }
.story-title { font-size: 40rpx; font-weight: 800; line-height: 1.3; }
.story-date { margin-top: 12rpx; font-size: 28rpx; font-weight: 600; color: var(--accent); }
.story-memo { margin-top: 24rpx; font-size: 32rpx; line-height: 1.7; }
.story-chips { margin-top: 24rpx; }
.story-note { margin-top: 24rpx; white-space: pre-wrap; }
button.secondary:not([size='mini']) { margin-top: var(--gap-card); }
