.invite { margin-top: 24rpx; padding: 32rpx; border: 1rpx solid var(--line); background: #fcf9f4; text-align: center; }
.invite-code { font-size: 72rpx; letter-spacing: 16rpx; color: var(--accent); margin: 16rpx 0 24rpx; }
.member { min-height: 88rpx; border-top: 1rpx solid var(--line); }
.entry { min-height: 120rpx; padding: 20rpx 24rpx; border: 1rpx solid var(--line); background: #fcf9f4; margin-bottom: 24rpx; }
.entry-arrow { color: var(--accent); font-size: 48rpx; }
