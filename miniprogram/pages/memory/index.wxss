.invite { text-align: center; margin-bottom: 24rpx; }
.invite-code { font-size: 72rpx; letter-spacing: 16rpx; color: var(--accent); margin: 12rpx 0 24rpx; }
.date-days { display: flex; align-items: baseline; gap: 6rpx; color: var(--accent); }
.days-number { font-size: 44rpx; }
.date-today { font-size: 28rpx; font-weight: 600; padding: 6rpx 18rpx; border-radius: 999rpx; background: var(--accent-soft); }
.date-passed .date-days { color: var(--muted); }
.later { margin: 16rpx 4rpx 0; }
.avatar { width: 64rpx; height: 64rpx; flex-shrink: 0; border-radius: 50%; background: var(--accent-soft); color: var(--accent); display: flex; align-items: center; justify-content: center; font-size: 30rpx; }
.export-button { margin-top: 20rpx; }
