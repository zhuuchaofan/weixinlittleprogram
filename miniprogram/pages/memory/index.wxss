.hero { position: relative; overflow: hidden; padding: 36rpx 36rpx 32rpx; border-radius: var(--radius); background: var(--accent-grad); color: #fff; box-shadow: 0 16rpx 40rpx var(--glow); }
.hero::after { content: ''; position: absolute; right: -80rpx; top: -120rpx; width: 320rpx; height: 320rpx; border-radius: 50%; background: rgba(255, 255, 255, 0.12); }
.hero-label { font-size: 26rpx; opacity: 0.92; }
.hero-days { margin: 8rpx 0 4rpx; font-size: 72rpx; font-weight: 800; line-height: 1.2; }
.hero-date { font-size: 24rpx; opacity: 0.9; }
.add, button.add:not([size='mini']) { margin-top: 24rpx; }
.plus { margin-right: 8rpx; }
.list-gap { margin-top: 24rpx; }
.date-days { display: flex; align-items: baseline; gap: 6rpx; color: var(--accent); }
.days-number { font-size: 44rpx; font-weight: 700; }
.date-today { font-size: 28rpx; font-weight: 600; padding: 6rpx 18rpx; border-radius: 999rpx; background: var(--accent-soft); }
.date-passed .date-days { color: var(--muted); }
.archive { margin-top: 40rpx; }
