<view class="page">
  <view class="kicker">小家 / 纪念</view>
  <view class="title">纪念</view>
  <view wx:if="{{loading && !household}}" class="status">正在读取…</view>
  <view wx:if="{{error}}" class="notice error">{{error}}<button class="text-button" bindtap="load">重试</button></view>

  <block wx:if="{{household}}">
    <view wx:if="{{household.inviteCode}}" class="invite">
      <view class="small muted">把邀请码发给对方，在「用邀请码加入」里输入</view>
      <view class="invite-code serif">{{household.inviteCode}}</view>
      <button class="secondary" bindtap="copyCode">复制邀请码</button>
    </view>

    <view class="section">
      <view class="section-title">成员</view>
      <view wx:for="{{household.members}}" wx:key="role" class="member inline">
        <text>{{item.name}}<text wx:if="{{item.isMe}}" class="small muted">（我）</text></text>
        <text class="tag">{{item.role === 'a' ? '创建者' : '成员'}}</text>
      </view>
    </view>

    <view class="section">
      <view class="section-title">设置</view>
      <view class="field">
        <text class="field-label">我的称呼</text>
        <input value="{{myName}}" maxlength="12" bindinput="inputName" />
      </view>
      <view class="field">
        <text class="field-label">所在城市</text>
        <input value="{{city}}" maxlength="20" bindinput="inputCity" />
      </view>
      <button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存</button>
      <view wx:if="{{message}}" class="notice">{{message}}</view>
    </view>

    <view class="section">
      <view class="section-title">回忆</view>
      <navigator class="entry inline" url="/pages/archive/index">
        <view><view>答谢宴 · 登记与祝福</view><view class="small muted">2026.09.28 亲友留下的话</view></view>
        <text class="entry-arrow">›</text>
      </navigator>
      <view class="empty">纪念日与回忆时间线，下一阶段开放。</view>
    </view>

    <view class="section">
      <view class="section-title">数据</view>
      <view class="small muted">把记账和清单全部复制为文本（JSON），用于备份。</view>
      <button class="secondary export-button" bindtap="exportData" loading="{{exporting}}" disabled="{{exporting}}">复制全部数据</button>
    </view>
    <view class="bottom-space"></view>
  </block>
</view>
