.went { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 28rpx; margin-bottom: 32rpx; }

.photos { display: flex; flex-wrap: wrap; gap: 16rpx; }
.photo { position: relative; width: 200rpx; height: 200rpx; border-radius: var(--radius-sm); background: var(--accent-soft); }
.photo-img { width: 100%; height: 100%; border-radius: var(--radius-sm); }
.photo-x { position: absolute; top: 0; right: 0; width: 80rpx; height: 80rpx; display: flex; align-items: flex-start; justify-content: flex-end; padding: 8rpx 12rpx; box-sizing: border-box; font-size: 32rpx; line-height: 1; color: #fff; text-shadow: 0 0 6rpx rgba(0, 0, 0, 0.6); }
.photo-add { display: flex; align-items: center; justify-content: center; font-size: 56rpx; color: var(--accent); border: 1rpx dashed var(--accent); box-sizing: border-box; background: transparent; }
