<view class="page program-editor">
  <button class="back-link" bindtap="back" disabled="{{loading}}">‹ 返回主人工作台</button>
  <view class="editor-heading"><view class="kicker">把相聚安排好</view><view class="title">当天流程</view><view class="lead">草稿只给主人看见；更新展示后，亲友会在答谢宴当天首页看到。</view></view>
  <view wx:if="{{error}}" class="notice error" role="alert">{{error}}<button class="text-button" bindtap="load" disabled="{{loading}}">重新读取</button></view>
  <view wx:if="{{message}}" class="notice">{{message}}</view>
  <view wx:if="{{loading}}" class="status">正在处理，请稍候…</view>
  <view wx:if="{{authorized}}">
    <view class="save-state">{{saveState}}</view><view class="save-bar"><button class="secondary" bindtap="save" disabled="{{loading}}">保存草稿</button><button class="primary" bindtap="publish" disabled="{{loading}}">更新展示</button></view>
    <view class="editor-guide">流程只在 9 月 28 日当天显示。现场临时调整后，请先保存草稿，再更新展示。</view>
    <view class="section form-section"><view class="field-title">流程标题</view><input value="{{program.title}}" maxlength="40" data-field="title" bindinput="updateMeta" placeholder="例如：今日流程" disabled="{{loading}}"/><view class="field-title">给宾客的一句话</view><textarea value="{{program.lead}}" maxlength="120" data-field="lead" bindinput="updateMeta" placeholder="以现场安排为准" disabled="{{loading}}"/>
    </view>
    <view class="inline section-heading"><view><view class="section-title">主持流程</view><view class="small muted">可修改、排序、隐藏或增加环节</view></view><text class="small muted">{{program.items.length}} / 20</text></view>
    <view wx:for="{{program.items}}" wx:key="id" class="program-entry"><view class="entry-heading"><text class="entry-number serif">{{index + 1 < 10 ? '0' : ''}}{{index + 1}}</text><text class="entry-title">第 {{index + 1}} 项</text><switch checked="{{item.visible}}" data-index="{{index}}" bindchange="toggleItem" color="#783e3c"/></view><input value="{{item.title}}" maxlength="40" data-index="{{index}}" data-field="title" bindinput="updateItem" placeholder="环节名称" disabled="{{loading}}"/><view class="time-row"><input value="{{item.time}}" maxlength="5" data-index="{{index}}" data-field="time" bindinput="updateItem" placeholder="时间，如 12:30" disabled="{{loading}}"/></view><textarea value="{{item.description}}" maxlength="80" data-index="{{index}}" data-field="description" bindinput="updateItem" placeholder="给宾客的提示（选填）" disabled="{{loading}}"/><view class="entry-tools"><button data-index="{{index}}" data-delta="-1" bindtap="moveItem" disabled="{{loading || index === 0}}">↑ 前移</button><button data-index="{{index}}" data-delta="1" bindtap="moveItem" disabled="{{loading || index === program.items.length - 1}}">↓ 后移</button><button class="remove-button" data-index="{{index}}" bindtap="removeItem" disabled="{{loading}}">移除</button></view></view>
    <button class="secondary add-item" bindtap="addItem" disabled="{{loading || program.items.length >= 20}}">＋ 增加流程环节</button>
    <view class="section-heading"><view class="section-title">Photo Booth</view><view class="small muted">独立提示，不计入主持流程编号</view></view><view class="booth-editor"><view class="entry-heading"><text>在首页显示</text><switch checked="{{program.photoBooth.enabled}}" bindchange="toggleBooth" color="#783e3c"/></view><input value="{{program.photoBooth.title}}" maxlength="40" data-field="title" bindinput="updateBooth" placeholder="例如：门口 Photo Booth" disabled="{{loading}}"/><input value="{{program.photoBooth.time}}" maxlength="5" data-field="time" bindinput="updateBooth" placeholder="开放时间，如 11:30" disabled="{{loading}}"/><textarea value="{{program.photoBooth.description}}" maxlength="120" data-field="description" bindinput="updateBooth" placeholder="给宾客的拍照提示" disabled="{{loading}}"/></view>
    <button class="text-button restore-button" bindtap="restoreDefault" disabled="{{loading}}">恢复内置默认流程</button>
  </view>
  <page-footer />
</view>