.editor-heading { margin: 28rpx 0 34rpx; }.lead { color: var(--muted); }.save-state { margin-bottom: 14rpx; color: var(--muted); font-size: 24rpx; }.save-bar { position: sticky; z-index: 4; top: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; padding: 16rpx 0; background: var(--paper); border-bottom: 1rpx solid var(--line); }.editor-guide { padding: 24rpx 0; color: var(--muted); font-size: 24rpx; line-height: 1.7; }.form-section { border-top: 1rpx solid var(--line); }.field-title { margin: 22rpx 0 10rpx; font-size: 27rpx; }.section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 18rpx; margin-top: 46rpx; padding-bottom: 18rpx; border-bottom: 1rpx solid var(--line); }.section-title { font-size: 37rpx; }.program-entry, .booth-editor { padding: 26rpx 0; border-bottom: 1rpx solid var(--line); }.entry-heading { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }.entry-number { color: var(--accent); font-size: 27rpx; }.entry-title { flex: 1; color: var(--muted); font-size: 23rpx; }.time-row { margin-top: 14rpx; }.entry-tools { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }.entry-tools button { min-width: 130rpx; margin: 0; padding: 12rpx 18rpx; font-size: 23rpx; }.remove-button { color: var(--accent); }.add-item { width: 100%; margin-top: 24rpx; }.restore-button { display: block; margin: 44rpx auto 18rpx; color: var(--accent); }