.invite-sheet { background: #fffaf2; border: 1rpx solid var(--line); padding: 48rpx 30rpx; text-align: center; }.couple { font-size: 42rpx; margin-top: 28rpx; }.invite-date { font-size: 62rpx; }.venue { font-size: 38rpx; margin-top: 34rpx; }.tip { display: flex; gap: 24rpx; margin-bottom: 28rpx; font-size: 28rpx; }.tip-index { color: var(--accent); font-size: 24rpx; flex-shrink: 0; }

.venue-branch { margin: 8rpx 0 18rpx; font-size: 28rpx; color: var(--muted); }
