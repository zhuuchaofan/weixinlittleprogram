<view class="page"><view class="kicker">{{copy.text01}}</view><view class="title">{{copy.text02}}</view><view class="lead">{{appConfig.invitation}}</view>
  <view wx:if="{{!appConfig.confirmed}}" class="notice">{{copy.text03}}</view>
  <view class="invite-sheet section"><view class="small muted">{{copy.text04}}</view><view class="couple serif">{{appConfig.names}}</view><view class="rule"></view><view class="invite-date serif">{{appConfig.date}}</view><view class="muted"><text wx:if="{{appConfig.lunarDate}}">{{appConfig.lunarDate}} · </text>{{appConfig.time}}</view><view class="venue serif">{{appConfig.venue}}</view><view wx:if="{{appConfig.hall}}">{{appConfig.hall}}</view><view class="small muted">{{appConfig.address}}</view><block wx:if="{{appConfig.parents}}"><view class="rule"></view><view class="muted">{{appConfig.parents}}</view><view class="small muted">{{copy.text05}}</view></block></view>
  <view class="actions"><button class="secondary" bindtap="map">{{appConfig.confirmed && appConfig.location ? copy.text06 : copy.text07}}</button><button class="secondary" bindtap="copy">{{copy.text08}}</button></view>
  <view class="section"><view class="section-title">{{copy.text09}}</view><view wx:for="{{appConfig.tips}}" wx:key="*this" class="tip"><text class="tip-index">0{{index + 1}}</text><text>{{item}}</text></view></view>
  <navigator wx:if="{{!collectionClosed}}" url="/pages/rsvp/index"><button class="primary">{{copy.text10}}</button></navigator><view wx:else class="notice">{{copy.collectionClosed}}</view><page-footer />
</view>
