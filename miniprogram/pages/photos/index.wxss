.photo-editor { --editor-surface: #fcf9f4; }

.editor-heading { padding: 10rpx 0 32rpx; }
.editor-heading .title { margin: 14rpx 0 20rpx; }
.editor-guide { margin: 22rpx 0 32rpx; color: var(--muted); font-size: 24rpx; line-height: 1.8; }
.media-add-actions { display: flex; gap: 16rpx; }
.upload-button { flex: 1 1 0; width: 0; min-width: 0; display: flex; justify-content: flex-start; gap: 14rpx; min-height: 128rpx; padding: 22rpx 18rpx; border: 1rpx solid var(--line); border-radius: 10rpx; background: var(--editor-surface); text-align: left; }
.video-upload-button { background: #f7eee5; }
.upload-plus { color: var(--accent); font-size: 44rpx; font-weight: 300; }
.upload-copy { flex: 1; min-width: 0; }
.upload-copy .small { margin-top: 4rpx; font-size: 22rpx; white-space: nowrap; }
.media-add-hint { margin: 14rpx 0 28rpx; color: var(--muted); font-size: 23rpx; text-align: center; }
.collection-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 16rpx; margin: 56rpx 0 8rpx; }
.collection-heading .section-title { margin: 0; }
.photo-entry { border-top: 1rpx solid var(--line); padding-bottom: 30rpx; margin-bottom: 18rpx; }
.entry-heading { display: flex; align-items: baseline; gap: 20rpx; padding: 20rpx 0; }
.entry-number { color: var(--accent); font-size: 40rpx; line-height: 1.2; }
.entry-slot { flex: 1; font-size: 27rpx; }
.entry-heading .small { font-size: 22rpx; }
.entry-overview { display: flex; align-items: stretch; gap: 22rpx; }
.editor-photo { flex: 0 0 202rpx; width: 202rpx; padding: 8rpx; background: var(--editor-surface); }
.entry-overview-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; justify-content: space-between; padding: 10rpx 0; }
.entry-overview-copy .small { line-height: 1.6; }
.edit-toggle { width: 100%; min-height: 84rpx; font-size: 25rpx; }
.entry-fields { margin-top: 26rpx; }
.field-title { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; font-size: 25rpx; }
.entry-fields input { font-size: 28rpx; background: var(--editor-surface); padding: 18rpx 22rpx; }
.input-placeholder { color: var(--muted); }
.placement { display: flex; justify-content: space-between; align-items: center; min-height: 100rpx; gap: 20rpx; border-bottom: 1rpx solid var(--line); font-size: 26rpx; }
.placement-value { color: var(--accent); }
.chevron { padding-left: 20rpx; }
.entry-tools { display: flex; padding-top: 14rpx; border-top: 1rpx solid var(--line); }
.entry-tools button { flex: 1; min-width: 0; padding: 18rpx 4rpx; font-size: 25rpx; min-height: 82rpx; }
.entry-tools button[disabled] { background: transparent; opacity: .55; }
.entry-tools .remove-button { color: var(--accent); }
.empty-title { color: var(--ink); font-size: 34rpx; margin-bottom: 18rpx; }
.closing-note { padding: 12rpx 0 24rpx; color: var(--muted); font-size: 24rpx; line-height: 1.9; text-align: center; }
.import-panel { padding: 24rpx; background: #eee3d4; margin: 12rpx 0 28rpx; }
.import-panel textarea { margin: 20rpx 0; height: 180rpx; font-size: 24rpx; }
.file-id-button { display: block; width: 100%; padding: 16rpx 0 2rpx; color: var(--muted); font-size: 22rpx; text-align: center; }
.cleanup-panel { margin: 12rpx 0 28rpx; padding: 28rpx 24rpx; border: 1rpx solid var(--line); background: #f6eee4; }
.cleanup-panel .section-title { margin: 0 0 12rpx; }
.cleanup-panel textarea { height: 156rpx; margin: 20rpx 0; font-size: 24rpx; background: var(--paper); }
.cleanup-result { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--line); color: var(--muted); font-size: 24rpx; line-height: 1.7; }
.cleanup-result .remove-button { width: 100%; margin-top: 18rpx; color: #fff; background: var(--accent); }
.save-state { color: var(--accent); font-size: 28rpx; padding: 14rpx 0; }
.photo-editor { padding-bottom: 60rpx; }
.media-filter { display: flex; gap: 12rpx; margin: 22rpx 0; }
.media-filter button { flex: 1; min-width: 0; font-size: 24rpx; color: var(--muted); background: var(--editor-surface); }
.media-filter button.selected { color: #fff; background: var(--accent); }
.privacy-hint { margin: 12rpx 0 20rpx; line-height: 1.6; }
.pending-panel { margin: 28rpx 0; padding: 24rpx; border: 1rpx solid var(--line); border-radius: 10rpx; background: #eee5d8; }
.pending-entry { margin: 24rpx 0; padding-bottom: 24rpx; border-bottom: 1rpx solid #d6c8b8; }
.pending-image { width: 100%; height: 300rpx; display: block; background: var(--editor-surface); }
.pending-entry .small { margin: 16rpx 0; }
@media (max-width: 350px) { .media-add-actions { gap: 12rpx; } .upload-button { padding: 20rpx 14rpx; } .upload-plus { font-size: 38rpx; } .upload-copy .small { font-size: 20rpx; } .editor-photo { flex-basis: 184rpx; width: 184rpx; } .entry-overview { gap: 16rpx; } }

/* 照片管理：上传入口、筛选与媒体清单 */
.photo-editor .editor-heading { padding-bottom: 24rpx; border-bottom: 1rpx solid var(--line); }
.photo-editor .editor-heading .title { margin-bottom: 12rpx; }
.photo-editor .editor-guide { margin: 16rpx 0 28rpx; padding-left: 20rpx; border-left: 3rpx solid var(--accent); }
.photo-editor .media-add-actions { margin-top: 22rpx; }
.photo-editor .upload-button { min-height: 142rpx; align-items: center; border-radius: 0; background: #eadbc7; }
.photo-editor .video-upload-button { background: #eee6db; }
.photo-editor .upload-plus { flex: 0 0 48rpx; font-size: 40rpx; text-align: center; }
.photo-editor .upload-copy > view:first-child { color: var(--ink); font-size: 28rpx; }
.photo-editor .media-add-hint { margin-bottom: 20rpx; }
.photo-editor .utility-actions { margin: 30rpx 0 0; border-top: 1rpx solid var(--line); }
.photo-editor .utility-actions .text-button { display: flex; justify-content: space-between; align-items: center; width: 100%; min-height: 76rpx; padding: 14rpx 2rpx; border-bottom: 1rpx solid var(--line); color: var(--muted); font-size: 24rpx; text-align: left; text-decoration: none; }
.photo-editor .utility-actions .text-button text { color: var(--accent); font-size: 34rpx; }
.photo-editor .collection-heading { margin-top: 64rpx; padding-bottom: 12rpx; border-bottom: 1rpx solid var(--line); }
.photo-editor .media-filter { gap: 0; margin: 20rpx 0 18rpx; border: 1rpx solid var(--line); }
.photo-editor .media-filter button { min-height: 78rpx; border-radius: 0; background: #fcf9f4; }
.photo-editor .media-filter button + button { border-left: 1rpx solid var(--line); }
.photo-editor .media-filter button.selected { background: var(--accent); color: #fff9ee; }
.photo-editor .photo-entry { margin: 22rpx 0 34rpx; padding: 0 0 20rpx; border-top: 1rpx solid var(--line); border-bottom: 1rpx solid var(--line); }
.photo-editor .entry-heading { gap: 16rpx; padding: 16rpx 0; }
.photo-editor .entry-number { font-size: 38rpx; }
.photo-editor .entry-slot { font-size: 26rpx; }
.photo-editor .entry-visibility { flex: 0 0 auto; padding: 3rpx 12rpx; border: 1rpx solid #d8caba; color: var(--muted); font-size: 20rpx; line-height: 1.5; }
.photo-editor .entry-visibility.private { border-color: var(--accent); color: var(--accent); }
.photo-editor .editor-photo { padding: 6rpx; border: 1rpx solid var(--line); }
.photo-editor .entry-overview-copy { padding: 4rpx 0; }
.photo-editor .edit-toggle { min-height: 78rpx; border-radius: 0; }
.photo-editor .entry-tools { margin-top: 18rpx; }
.photo-editor .entry-tools button { font-size: 23rpx; }
.photo-editor .file-id-button { min-height: 58rpx; }
@media (max-width: 350px) { .photo-editor .upload-button { padding: 16rpx 10rpx; gap: 8rpx; } .photo-editor .upload-plus { flex-basis: 36rpx; font-size: 32rpx; } .photo-editor .upload-copy > view:first-child { font-size: 25rpx; } .photo-editor .entry-visibility { font-size: 18rpx; padding: 3rpx 8rpx; } }
