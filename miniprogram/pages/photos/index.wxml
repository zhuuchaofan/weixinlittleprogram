<view class="page photo-editor">
  <page-back-link label="返回主人工作台" disabled="{{busy}}" bind:back="back" />
  <view class="editor-heading"><view class="kicker">把回忆安放好</view><view class="title">照片管理</view><view class="lead preline">一张照片，一段日常。
让亲友看见我们喜欢的模样。</view></view>
  <view wx:if="{{error}}" class="notice error" role="alert">{{error}}<button wx:if="{{loadFailed}}" class="text-button" bindtap="load" disabled="{{busy}}">重新读取</button></view>
  <button wx:if="{{diagnostic}}" class="text-button" bindtap="copyDiagnostic">复制上传诊断详情</button>
  <view wx:if="{{message}}" class="notice" aria-live="polite">{{message}}</view>
  <view wx:if="{{busy}}" class="status">正在处理，请稍候…</view>
  <view wx:if="{{authorized && !loadFailed}}">
    <view class="save-state" aria-live="polite">{{saveState}}</view><editor-action-bar publish-label="更新展示" disabled="{{busy}}" bind:save="save" bind:publish="publish" />
    <view class="editor-guide preline">草稿留给自己，更新展示后亲友才会看到。
离开前，记得保存这次整理。</view>
    <view class="media-add-actions">
      <button class="upload-button" bindtap="add" disabled="{{busy || photos.length >= 60}}"><text class="upload-plus">＋</text><view class="upload-copy"><view>添加照片</view><view class="small muted">最多 9 张</view></view></button>
      <button class="upload-button video-upload-button" bindtap="add" data-type="video" disabled="{{busy || photos.length + pending.length >= 60}}"><text class="upload-plus">▶</text><view class="upload-copy"><view>添加视频</view><view class="small muted">60 秒 · 30 MB 内</view></view></button>
    </view>
    <view class="media-add-hint">可先预览、移除，再上传并保存草稿。</view>
    <view wx:if="{{pending.length}}" class="pending-panel">
      <view class="section-title">待上传 / 待保存 · {{pending.length}}</view>
      <view wx:for="{{pending}}" wx:key="id" class="pending-entry">
        <media-video wx:if="{{item.type === 'video'}}" src="{{item.path}}" cover="{{item.coverPath}}" ratio="{{item.width > item.height ? 'landscape' : 'portrait'}}" />
        <image wx:else src="{{item.path}}" mode="aspectFit" class="pending-image" data-index="{{index}}" bindtap="pendingPreview" aria-label="预览待上传照片" />
        <view class="small" aria-live="polite">{{item.message}}</view>
        <progress wx:if="{{item.status === 'uploading'}}" percent="{{item.progress}}" show-info="{{true}}" activeColor="#783e3c" />
        <view class="entry-tools"><button data-index="{{index}}" bindtap="removePending" disabled="{{busy}}">移除</button>
        <button wx:if="{{item.status === 'failed' || item.status === 'uploaded'}}" data-id="{{item.id}}" bindtap="uploadPending" disabled="{{busy}}">{{item.media ? '重试保存' : '重试上传'}}</button></view>
        <button wx:if="{{item.fileID}}" class="text-button" data-index="{{index}}" bindtap="copyPendingFile">复制媒体文件 ID</button>
        <button wx:if="{{item.coverID}}" class="text-button" data-index="{{index}}" data-cover="{{true}}" bindtap="copyPendingFile">复制封面文件 ID</button>
      </view>
      <button class="secondary" bindtap="uploadPending" loading="{{busy}}" disabled="{{busy}}">上传并保存待处理媒体</button>
    </view>
    <button class="text-button" bindtap="toggleImport" disabled="{{busy}}">已上传过？用文件 ID 导入</button><button class="text-button" bindtap="toggleCleanup" disabled="{{busy}}">清理不再使用的云端照片</button>
    <view wx:if="{{importVisible}}" class="import-panel"><view class="small muted">粘贴云存储中的完整 File ID，无需重复上传。导入后请确认图片能正常显示。</view><textarea value="{{importId}}" bindinput="importInput" placeholder="cloud://…" maxlength="1024" disabled="{{busy}}" aria-label="已上传照片的文件 ID"/><button class="secondary" bindtap="importPhoto" disabled="{{busy}}">加入照片并保存草稿</button></view>
    <view wx:if="{{cleanupVisible}}" class="cleanup-panel"><view class="section-title">云端文件清理</view><view class="small muted">仅清理由本小程序上传的 wedding/managed/ JPG、PNG 或 MP4。先从草稿和已展示内容移除，再检查是否可删；手动上传的原图请在云开发控制台管理。</view><textarea value="{{cleanupId}}" bindinput="cleanupInput" placeholder="粘贴完整 cloud:// 文件 ID" maxlength="1024" disabled="{{busy}}" aria-label="需要清理的照片文件 ID"/><button class="secondary" bindtap="inspectCleanup" disabled="{{busy}}">检查是否可安全删除</button><view wx:if="{{cleanupInspection}}" class="cleanup-result"><view>草稿引用：{{cleanupInspection.references.draft}} · 已展示引用：{{cleanupInspection.references.published}}</view><button wx:if="{{cleanupInspection.deletable}}" class="remove-button" bindtap="deleteCleanup" disabled="{{busy}}">永久删除云端文件</button></view></view>
    <view class="collection-heading"><text class="section-title">正在整理</text><text class="small muted">{{photos.length}} / 60 个展示位置</text></view>
    <view wx:if="{{!photos.length}}" class="empty"><view class="empty-title serif">留一点位置，给新的回忆</view><view>点击上方添加照片，开始布置吧。</view></view>
    <picker range="{{filterLabels}}" value="{{filterIndex}}" bindchange="filterChange"><view class="placement">按用途查看：{{filterLabels[filterIndex]}}</view></picker><block wx:for="{{photos}}" wx:key="id"><view wx:if="{{filter === 'all' || item.slot === filter}}" class="photo-entry">
      <view class="entry-heading"><text class="entry-number serif">{{index >= 9 ? '' : '0'}}{{index + 1}}</text><text class="entry-slot">{{item.slot === 'album' ? '婚纱照相册' : item.slot === 'cover' ? '首页封面' : item.slot === 'story' ? '故事照片' : item.slot === 'qiuqiu' ? '球球的日常' : '布丁的日常'}}</text><text class="small muted">{{item.type === 'video' ? '点击播放视频' : '轻点看大图'}}</text></view>
      <view class="entry-overview"><view class="editor-photo"><media-video wx:if="{{item.type === 'video'}}" src="{{item.original}}" cover="{{item.coverUrl || item.thumbnail}}" caption="{{item.caption}}" ratio="{{item.ratio}}" /><photo-frame wx:else src="{{item.thumbnail}}" caption="{{item.caption}}" ratio="landscape" adaptive="{{false}}" data-index="{{index}}" bind:open="preview"/></view>
      <view class="entry-overview-copy"><view class="small muted">{{item.type === 'video' ? '视频已放入相册' : '可添加说明、调整用途'}}</view><button class="edit-toggle secondary" data-id="{{item.id}}" bindtap="toggleEdit">{{expandedId === item.id ? '收起编辑' : '编辑说明与用途'}}</button></view></view><view wx:if="{{expandedId === item.id}}"><view class="entry-fields"><view class="field-title"><text>{{item.type === 'video' ? '视频说明' : '照片说明'}}</text><text class="small muted">{{item.caption.length}} / 80</text></view><input value="{{item.caption}}" placeholder="给这一刻写一句话…" placeholder-class="input-placeholder" aria-label="照片说明" maxlength="80" data-index="{{index}}" bindinput="caption" disabled="{{busy}}"/>
      <view wx:if="{{item.type === 'video'}}" class="small muted">视频展示在相册中</view><picker wx:else range="{{slots}}" value="{{item.slot === 'album' ? 0 : item.slot === 'cover' ? 1 : item.slot === 'story' ? 2 : item.slot === 'qiuqiu' ? 3 : 4}}" data-index="{{index}}" bindchange="slot" disabled="{{busy}}"><view class="placement"><text class="muted">放在哪里</text><text class="placement-value">{{item.slot === 'album' ? '婚纱照相册' : item.slot === 'cover' ? '首页封面' : item.slot === 'story' ? '故事照片' : item.slot === 'qiuqiu' ? '球球' : '布丁'}}<text class="chevron">⌄</text></text></view></picker></view>
      <view class="entry-tools"><button data-index="{{index}}" data-delta="-1" bindtap="move" disabled="{{busy || index === 0}}" aria-label="前移照片">↑ 前移</button><button data-index="{{index}}" data-delta="1" bindtap="move" disabled="{{busy || index === photos.length - 1}}" aria-label="后移照片">↓ 后移</button><button data-index="{{index}}" bindtap="duplicate" disabled="{{busy || photos.length >= 60}}">复用</button><button class="remove-button" data-index="{{index}}" bindtap="remove" disabled="{{busy}}">移除</button></view><button class="file-id-button" data-index="{{index}}" bindtap="copyFileId" disabled="{{busy}}">复制媒体 File ID</button><button wx:if="{{item.type === 'video' && item.coverUrl}}" class="file-id-button" data-index="{{index}}" data-cover="{{true}}" bindtap="copyFileId" disabled="{{busy}}">复制视频封面 File ID</button>
    </view></view></block>
    <view wx:if="{{photos.length}}" class="closing-note preline">同一张照片想放在两处？点击「复用」。
移除只改变展示，云端照片仍会保留。</view>
  </view>
<page-footer wx:if="{{!dirty}}" /></view>