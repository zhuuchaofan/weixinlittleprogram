.rule { margin-top: var(--gap-sm); font-size: 28rpx; line-height: 1.7; }
.warn-text { color: var(--warn); }
.backup-button, button.backup-button:not([size='mini']) { margin-top: var(--gap); }
.confirm-card { margin-top: var(--gap); }
.delete-button, button.delete-button:not([size='mini']) { margin-top: var(--gap-lg); color: var(--danger); }
