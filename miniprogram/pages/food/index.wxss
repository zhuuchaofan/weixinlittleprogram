.draw-card { margin-top: 24rpx; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding: 44rpx 32rpx 32rpx; }
.draw-icon { width: 112rpx; height: 112rpx; border-radius: 50%; background: var(--accent-soft); color: var(--accent); font-size: 60rpx; display: flex; align-items: center; justify-content: center; }
.picked-name { font-size: 68rpx; color: var(--accent); line-height: 1.3; }
.draw-button { margin-top: 20rpx; }
.composer { padding: 24rpx; }
.composer-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 20rpx; }
.composer-row .chips { gap: 12rpx; min-width: 0; flex: 1; }
.composer-row .chip { padding: 0 22rpx; }
.list-gap { margin-top: 24rpx; }
.tag-filter { margin-top: 16rpx; }
.composer-kind { margin-bottom: 20rpx; }
