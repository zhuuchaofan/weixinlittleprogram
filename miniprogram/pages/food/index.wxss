.draw-card { margin-top: 24rpx; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding: 40rpx 32rpx 28rpx; }
.draw-label { font-size: 26rpx; opacity: 0.92; }
.draw-icon { width: 112rpx; height: 112rpx; border-radius: 36rpx; background: #fff; display: flex; align-items: center; justify-content: center; }
.draw-icon-img { width: 60rpx; height: 60rpx; }
.picked-name { font-size: 68rpx; font-weight: 800; line-height: 1.3; }
.draw-actions { position: relative; z-index: 1; display: flex; gap: 16rpx; width: 100%; margin-top: 12rpx; }
.draw-actions .draw-button { flex: 1; margin-top: 0; }
.draw-button, button.draw-button:not([size='mini']) { position: relative; z-index: 1; margin-top: 12rpx; background: #fff; color: var(--accent); font-weight: 600; }
.draw-ghost, button.draw-ghost:not([size='mini']) { background: rgba(255, 255, 255, 0.24); color: #fff; }
.draw-hint { position: relative; z-index: 1; font-size: 22rpx; opacity: 0.85; }
.composer { margin-top: 24rpx; }

.ask-card { margin-top: 16rpx; }
.ask-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.ask-title { font-size: 28rpx; font-weight: 700; }
.ask-row { display: flex; align-items: center; gap: 16rpx; min-height: 88rpx; }

.draw-rate-label { position: relative; z-index: 1; margin-top: 8rpx; }

/* 菜单每行右边的「想吃 / 不想」，两个人各点各的，过了今天自动清空 */
.vote { display: flex; flex-shrink: 0; gap: 12rpx; }
.vote-chip { height: 64rpx; padding: 0 20rpx; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; border: 1rpx solid var(--line); background: var(--surface); color: var(--muted); font-size: 26rpx; white-space: nowrap; }
.vote-want { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); font-weight: 600; }
.vote-no { background: var(--danger-soft); border-color: var(--danger); color: var(--danger); font-weight: 600; }
