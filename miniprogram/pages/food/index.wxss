.draw-card { position: relative; overflow: hidden; margin-top: 24rpx; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding: 44rpx 32rpx 32rpx; border-radius: var(--radius); background: var(--accent-grad); color: #fff; box-shadow: 0 16rpx 40rpx rgba(242, 97, 79, 0.28); }
.draw-card::after { content: ''; position: absolute; right: -80rpx; top: -120rpx; width: 360rpx; height: 360rpx; border-radius: 50%; background: rgba(255, 255, 255, 0.12); }
.draw-label { font-size: 26rpx; opacity: 0.92; }
.draw-icon { width: 112rpx; height: 112rpx; border-radius: 36rpx; background: #fff; display: flex; align-items: center; justify-content: center; }
.draw-icon-img { width: 60rpx; height: 60rpx; }
.picked-name { font-size: 68rpx; font-weight: 800; line-height: 1.3; }
.draw-tag { font-size: 24rpx; padding: 4rpx 20rpx; border-radius: 999rpx; background: rgba(255, 255, 255, 0.22); }
.draw-button, button.draw-button:not([size='mini']) { position: relative; z-index: 1; margin-top: 20rpx; background: #fff; color: var(--accent); font-weight: 600; }
.composer { padding: 24rpx; }
.composer-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 20rpx; }
.composer-row .chips { gap: 12rpx; min-width: 0; flex: 1; }
.composer-row .chip { padding: 0 22rpx; }
.list-gap { margin-top: 24rpx; }
.tag-filter { margin-top: 16rpx; }
.composer-kind { margin-bottom: 20rpx; }
