<page-meta page-style="{{themeStyle}}" />
<view class="page">
  <view class="segmented">
    <view class="segment {{filter === '' ? 'segment-on' : ''}}" data-value="" bindtap="chooseFilter">全部</view>
    <view wx:for="{{tags}}" wx:key="value" class="segment {{filter === item.value ? 'segment-on' : ''}}" data-value="{{item.value}}" bindtap="chooseFilter">{{item.label}}</view>
  </view>

  <view class="draw-card grad-card">
    <block wx:if="{{picked}}">
      <view class="draw-label">今天就吃</view>
      <view class="picked-name">{{picked.name}}</view>
      <view class="draw-actions">
        <button class="draw-button" bindtap="eat" disabled="{{busy}}">{{picked.ateToday ? '记下了' : '就吃这个'}}</button>
        <button class="draw-button draw-ghost" bindtap="draw">换一个</button>
      </view>
    </block>
    <block wx:else>
      <view class="draw-icon"><image class="draw-icon-img" src="/images/cat-icons/food.svg" /></view>
      <view class="draw-label">不知道吃啥？从{{filter ? '「' + filterText + '」' : ''}} {{visible.length}} 个里抽一个</view>
      <button class="draw-button" bindtap="draw">抽一个</button>
    </block>
    <view class="draw-hint">最近 3 天吃过的不会抽到</view>
  </view>

  <view class="composer">
    <input class="composer-input" value="{{name}}" maxlength="{{limits.dishName}}" placeholder="加一个（存到「{{addText}}」）" confirm-type="done" confirm-hold bindinput="inputName" bindconfirm="add" />
    <button class="primary btn-inline" bindtap="add" disabled="{{busy}}">添加</button>
  </view>

  <view wx:if="{{error}}" class="notice error">{{error}}</view>

  <view wx:if="{{loading && !dishes.length}}" class="status">正在读取…</view>
  <view wx:elif="{{!visible.length}}" class="empty list-gap">{{filter ? '这一类还没有，在上面加一个。' : '还没有记录，先加几道常吃的菜或常去的店吧。'}}</view>
  <block wx:for="{{groups}}" wx:for-item="group" wx:key="tag">
    <view class="list-label">{{group.label}} · {{group.items.length}}</view>
    <view class="list">
      <view wx:for="{{group.items}}" wx:key="id" class="list-row" data-id="{{item.id}}" bindtap="open" hover-class="list-row-active">
        <view class="tile {{group.tile}}"><image class="tile-icon" src="{{group.icon}}" /></view>
        <view class="row-main">
          <view class="row-title">{{item.name}}</view>
          <view wx:if="{{item.ateText}}" class="row-sub">{{item.ateText}}</view>
        </view>
        <text class="chevron">›</text>
      </view>
    </view>
  </block>
  <view class="page-end"></view>
</view>
