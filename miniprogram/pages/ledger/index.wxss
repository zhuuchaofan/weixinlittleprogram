/* 本月总额：渐变大卡片 */
.hero { padding: 36rpx 36rpx 32rpx; }
.hero-label { font-size: 24rpx; opacity: 0.92; }
.hero-total { font-size: 80rpx; font-weight: 800; line-height: 1.2; margin: 8rpx 0 24rpx; letter-spacing: -1rpx; }
.hero-track { height: 12rpx; border-radius: 6rpx; background: rgba(255, 255, 255, 0.35); overflow: hidden; }
.hero-share { height: 100%; border-radius: 6rpx; background: #fff; }
.hero-paid { display: flex; justify-content: space-between; gap: 20rpx; margin-top: 16rpx; font-size: 24rpx; font-weight: 600; }
.suggestion { position: relative; z-index: 1; margin-top: 24rpx; padding: 16rpx 24rpx; border-radius: var(--radius-sm); background: rgba(255, 255, 255, 0.2); font-size: 26rpx; }
.hero-button, button.hero-button:not([size='mini']) { position: relative; z-index: 1; margin-top: 20rpx; min-height: 80rpx; background: #fff; color: var(--accent); font-weight: 600; }

/* 按分类：一条彩色堆叠条 + 图例 */
.categories { margin-top: var(--gap-card); padding: 28rpx 32rpx 16rpx; }
.stack-bar { display: flex; gap: 4rpx; height: 16rpx; border-radius: 8rpx; overflow: hidden; margin-bottom: 8rpx; }
.stack-seg { min-width: 4rpx; height: 100%; }
.cat-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0 16rpx; min-height: 64rpx; }
/* 设了预算的分类：下面一行进度和「用了 N%」，80% 起变主色，超出变红 */
.budget-line { width: 100%; display: flex; align-items: center; gap: 16rpx; padding: 0 0 12rpx 32rpx; color: var(--muted); }
.budget-track { flex: 1; height: 8rpx; border-radius: 4rpx; background: var(--sunken); overflow: hidden; }
.budget-bar { height: 100%; border-radius: 4rpx; background: var(--ok); }
.budget-warn { color: var(--accent); }
.budget-warn .budget-bar { background: var(--accent); }
.budget-over { color: var(--danger); }
.budget-over .budget-bar { background: var(--danger); }
.cat-name { flex: 1; min-width: 0; font-size: 28rpx; white-space: nowrap; }
.cat-percent { width: 72rpx; flex-shrink: 0; text-align: right; }
.insight-link { display: flex; align-items: center; justify-content: flex-end; gap: 8rpx; min-height: 88rpx; margin-top: 8rpx; border-top: 1rpx solid var(--line); color: var(--accent); font-size: 26rpx; }
.insight-link .chevron { color: var(--accent); }
.insight-link-active { opacity: 0.7; }
.cat-amount { width: 180rpx; flex-shrink: 0; text-align: right; font-size: 28rpx; font-weight: 600; white-space: nowrap; }

/* 明细 */
.section-head { margin-top: 32rpx; }
.amount { font-size: 32rpx; }
.income { color: var(--ok); }
.row-settlement .row-title, .row-settlement .amount { color: var(--muted); }
.by-partner { color: var(--accent); }

/* 底部浮动按钮 */
.page-end { height: 200rpx; }
.fab-row { position: fixed; left: 0; right: 0; bottom: calc(32rpx + env(safe-area-inset-bottom)); display: flex; justify-content: center; gap: 20rpx; z-index: 10; pointer-events: none; }
.fab { pointer-events: auto; display: flex; align-items: center; gap: 10rpx; height: 96rpx; padding: 0 48rpx; border-radius: 48rpx; background: var(--dark); color: #fff; font-size: 30rpx; font-weight: 600; box-shadow: 0 12rpx 32rpx rgba(38, 33, 31, 0.28); }
.fab-light { background: var(--surface); color: var(--ink); padding: 0 36rpx; box-shadow: 0 8rpx 24rpx rgba(38, 33, 31, 0.12); }
.fab-plus { font-size: 40rpx; font-weight: 400; line-height: 1; }
.fab-active { opacity: 0.85; }
.list-end { text-align: center; padding: 28rpx 0 8rpx; }
