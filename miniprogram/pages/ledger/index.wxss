.month-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.month-arrow { width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-size: 48rpx; color: var(--accent); }
.month-arrow-active { background: var(--sunken); }
.month-arrow-off { color: var(--line); }
.month-text { font-size: 38rpx; white-space: nowrap; }
.total { font-size: 72rpx; color: var(--accent); line-height: 1.25; margin: 4rpx 0 20rpx; }
.paid { display: flex; gap: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--line); }
.paid-item { flex: 1; min-width: 0; }
.paid-value { font-size: 32rpx; margin-top: 4rpx; }
.page .add-button { margin: 32rpx 0 8rpx; }
.cat-badge { width: 64rpx; height: 64rpx; flex-shrink: 0; border-radius: 50%; background: var(--accent-soft); color: var(--accent); display: flex; align-items: center; justify-content: center; font-size: 26rpx; }
.amount { font-size: 34rpx; }
.row-settlement .cat-badge { background: var(--ok-soft); color: var(--ok); }
.row-settlement .row-title, .row-settlement .amount { color: var(--muted); }
.by-partner { color: var(--accent); }
.categories { margin-top: 24rpx; }
.cat-row { display: flex; align-items: center; gap: 16rpx; margin-top: 18rpx; }
.cat-name { width: 96rpx; flex-shrink: 0; font-size: 28rpx; white-space: nowrap; }
.cat-track { flex: 1; min-width: 0; height: 16rpx; border-radius: 8rpx; background: var(--sunken); overflow: hidden; }
.cat-bar { height: 100%; border-radius: 8rpx; background: var(--accent); }
.cat-percent { width: 64rpx; flex-shrink: 0; text-align: right; }
.cat-amount { width: 170rpx; flex-shrink: 0; text-align: right; font-size: 28rpx; white-space: nowrap; }
