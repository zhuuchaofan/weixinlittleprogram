<view class="page">
  <view class="month-bar">
    <view class="month-arrow" data-delta="-1" bindtap="changeMonth" hover-class="month-arrow-active" aria-role="button" aria-label="上个月">‹</view>
    <view class="month-text serif">{{monthText}}</view>
    <view class="month-arrow {{isCurrentMonth ? 'month-arrow-off' : ''}}" data-delta="1" bindtap="changeMonth" hover-class="{{isCurrentMonth ? 'none' : 'month-arrow-active'}}" aria-role="button" aria-label="下个月">›</view>
  </view>

  <view wx:if="{{error}}" class="notice error">{{error}}<button class="text-button" bindtap="load">重试</button></view>

  <view class="card spent">
    <view class="small muted">本月合计支出</view>
    <view class="total serif">{{summary ? spentText.total : '—'}}</view>
    <view class="paid">
      <view class="paid-item"><view class="small muted">{{names.a}} 共付</view><view class="paid-value">{{summary ? spentText.a : '—'}}</view></view>
      <view class="paid-item"><view class="small muted">{{names.b}} 共付</view><view class="paid-value">{{summary ? spentText.b : '—'}}</view></view>
    </view>
  </view>

  <view wx:if="{{categories.length}}" class="card categories">
    <view class="small muted">按分类</view>
    <view wx:for="{{categories}}" wx:key="cat" class="cat-row" aria-label="{{item.cat}} {{item.amountText}}，占 {{item.percent}}%">
      <view class="cat-name">{{item.cat}}</view>
      <view class="cat-track"><view class="cat-bar" style="width: {{item.width}}%"></view></view>
      <view class="cat-percent small muted">{{item.percent}}%</view>
      <view class="cat-amount">{{item.amountText}}</view>
    </view>
  </view>

  <button class="primary add-button" bindtap="add">记一笔</button>

  <view class="section-head">
    <view class="section-title">明细</view>
    <text wx:if="{{records.length}}" class="small muted">{{records.length}} 笔</text>
  </view>
  <view wx:if="{{loading && !summary}}" class="status">正在读取…</view>
  <view wx:elif="{{!records.length}}" class="empty">这个月还没有记账。</view>
  <view wx:else class="list">
    <view wx:for="{{records}}" wx:key="id" class="list-row {{item.isSettlement ? 'row-settlement' : ''}}" data-id="{{item.id}}" bindtap="open" hover-class="list-row-active">
      <view class="cat-badge">{{item.isSettlement ? '结' : item.cat[0]}}</view>
      <view class="row-main">
        <view class="row-title">{{item.note || item.cat}}</view>
        <view class="row-sub">{{item.dateText}} · {{item.payerName}}付 · {{item.splitText}}<text wx:if="{{item.byText}}" class="by-partner"> · {{item.byText}}</text><text wx:if="{{item.editedText}}" class="by-partner"> · {{item.editedText}}</text></view>
      </view>
      <view class="row-trail amount serif">{{item.amountText}}</view>
    </view>
  </view>
  <view class="page-end"></view>
</view>
