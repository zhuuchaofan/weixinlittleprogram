<page-meta page-style="{{themeStyle}}" />
<view class="page">
  <view class="month-bar">
    <view class="month-arrow" data-delta="-1" bindtap="changeMonth" hover-class="month-arrow-active" aria-role="button" aria-label="上个月">‹</view>
    <view class="month-text">{{monthText}}</view>
    <view class="month-arrow {{isCurrentMonth ? 'month-arrow-off' : ''}}" data-delta="1" bindtap="changeMonth" hover-class="{{isCurrentMonth ? 'none' : 'month-arrow-active'}}" aria-role="button" aria-label="下个月">›</view>
  </view>

  <view wx:if="{{error}}" class="notice error">{{error}}<button class="text-button" bindtap="load">重试</button></view>

  <view class="hero grad-card">
    <view class="hero-label">{{monthText}} · {{splitting ? '共同支出' : '支出'}}</view>
    <view class="hero-total">{{summary ? summaryText.total : '—'}}</view>
    <view class="hero-track" aria-hidden="true"><view class="hero-share" style="width: {{shareA}}%"></view></view>
    <view class="hero-paid">
      <text>{{names.a}} 付 {{summary ? summaryText.a : '—'}}</text>
      <text>{{names.b}} 付 {{summary ? summaryText.b : '—'}}</text>
    </view>
    <block wx:if="{{summary && splitting}}">
      <view class="suggestion">{{summary.settled ? '✓ ' : ''}}{{summaryText.suggestion}}</view>
      <button wx:if="{{!summary.settled}}" class="hero-button" bindtap="settle" loading="{{busy}}" disabled="{{busy}}">记为已结算</button>
    </block>
  </view>

  <view wx:if="{{categories.length}}" class="card categories">
    <view class="stack-bar" aria-hidden="true">
      <view wx:for="{{categories}}" wx:key="cat" class="stack-seg" style="flex: {{item.width}}; background: {{item.color}}"></view>
    </view>
    <view wx:for="{{categories}}" wx:key="cat" class="cat-row" aria-label="{{item.cat}} {{item.amountText}}，占 {{item.percent}}%">
      <view class="cat-dot" style="background: {{item.color}}"></view>
      <view class="cat-name">{{item.cat}}</view>
      <view class="cat-percent small muted">{{item.percent}}%</view>
      <view class="cat-amount">{{item.amountText}}</view>
    </view>
  </view>

  <view class="section-head">
    <view class="section-title">明细</view>
    <text wx:if="{{total}}" class="small muted">{{total}} 笔</text>
  </view>
  <view wx:if="{{loading && !summary}}" class="status">正在读取…</view>
  <view wx:elif="{{!records.length}}" class="empty">这个月还没有记账。</view>
  <view wx:else class="list">
    <view wx:for="{{records}}" wx:key="id" class="list-row {{item.isSettlement ? 'row-settlement' : ''}}" data-id="{{item.id}}" bindtap="open" hover-class="list-row-active">
      <view class="tile" style="background: {{item.tint}}"><image class="tile-icon" src="{{item.icon}}" /></view>
      <view class="row-main">
        <view class="row-title">{{item.note || item.cat}}</view>
        <view class="row-sub">{{item.dateText}} · {{item.payerName}}{{item.isIncome ? '收' : '付'}}<text wx:if="{{item.splitText}}"> · {{item.splitText}}</text><text wx:if="{{item.byText}}" class="by-partner"> · {{item.byText}}</text><text wx:if="{{item.editedText}}" class="by-partner"> · {{item.editedText}}</text><text wx:if="{{item.sourceText}}"> · {{item.sourceText}}</text></view>
      </view>
      <view class="row-trail amount serif {{item.isIncome ? 'income' : ''}}">{{item.amountText}}</view>
    </view>
  </view>
  <view wx:if="{{hasMore}}" class="list-end small muted">继续往上滑，显示更多</view>
  <view wx:elif="{{total > 30}}" class="list-end small muted">这个月的 {{total}} 笔都在这里了</view>
  <view class="page-end"></view>

  <view class="fab-row">
    <view class="fab fab-light" bindtap="importScreenshots" hover-class="fab-active" aria-role="button">截图记账</view>
    <view class="fab" bindtap="add" hover-class="fab-active" aria-role="button"><text class="fab-plus">+</text>记一笔</view>
  </view>
</view>
