<page-meta page-style="{{themeStyle}}" />
<view class="page">
  <view wx:if="{{loading && !household}}" class="status"><view class="status-paws" aria-hidden="true"><image class="status-paws-img" src="/images/themes/{{themeId}}/paw-trail.svg" /></view>正在读取…</view>
  <view wx:if="{{error}}" class="notice error">{{error}}<button class="text-button" bindtap="load">再试一次</button></view>
  <view wx:if="{{message}}" class="notice">{{message}}</view>

  <block wx:if="{{household}}">
    <view class="section-head"><view class="section-title">成员</view></view>
    <view class="list">
      <view wx:for="{{household.members}}" wx:key="role" class="list-row">
        <view class="avatar {{item.role === 'a' ? 'avatar-a' : 'avatar-b'}}">{{item.name[0]}}</view>
        <view class="row-main">{{item.name}}<text wx:if="{{item.isMe}}" class="small muted">（我）</text></view>
        <text class="tag">{{item.role === 'a' ? '创建者' : '成员'}}</text>
      </view>
      <view wx:if="{{household.inviteCode}}" class="list-row">
        <view class="row-main"><view class="row-title">邀请码 {{household.inviteCode}}</view><view class="row-sub">对方加入后自动失效</view></view>
        <button class="text-button" open-type="share">邀请 TA</button>
        <button class="text-button" bindtap="copyCode">复制</button>
      </view>
    </view>

    <view class="section">
      <view class="section-head"><view class="section-title">会员</view></view>
      <view class="list">
        <view class="list-row" bindtap="openVip" hover-class="list-row-active" aria-role="button">
          <view class="row-main"><view>{{vipText}}</view><view class="row-sub">截图记账、喵喵小结、一句话加清单、吃啥帮我挑、纪念日点子每天的次数更多。一个人开通，两个人共用。</view></view>
          <text class="chevron">›</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head"><view class="section-title">记账</view><text class="small muted">两个人共用</text></view>
      <view class="list">
        <view class="list-row">
          <view class="row-main"><view>两人分摊与结算</view><view class="row-sub">关闭时只记账：不选怎么分，不算谁该给谁多少。</view></view>
          <switch checked="{{household.splitting}}" color="{{accent}}" bindchange="toggleSplitting" />
        </view>
        <view class="list-row" bindtap="openBudgets" hover-class="list-row-active" aria-role="button">
          <view class="row-main"><view>分类预算</view><view class="row-sub">给某几类定每月上限，花到 80% 和超出时提醒。</view></view>
          <text class="chevron">›</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head"><view class="section-title">我的资料</view></view>
      <view class="card">
        <view class="field">
          <text class="field-label">我的称呼</text>
          <input value="{{myName}}" maxlength="12" bindinput="inputName" />
        </view>
        <view class="field">
          <text class="field-label">我的微信名字</text>
          <input value="{{myPayName}}" maxlength="20" placeholder="可不填" bindinput="inputPayName" />
        </view>
        <view class="small muted">填你在微信、支付宝里显示的名字，导入账单时对方转给你、你转给对方的钱就不会重复记。</view>
        <button class="primary save-button" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存</button>
      </view>
    </view>

    <view class="section">
      <view class="section-head"><view class="section-title">主题</view><text class="small muted">只改这台手机</text></view>
      <view class="card themes">
        <view wx:for="{{themes}}" wx:key="id" class="theme {{themeId === item.id ? 'theme-on' : ''}}" data-id="{{item.id}}" bindtap="chooseTheme" aria-role="radio" aria-checked="{{themeId === item.id}}" aria-label="{{item.name}}">
          <view class="swatch" style="background: {{item.swatch}}"><image wx:if="{{themeId === item.id}}" class="swatch-paw" src="/images/ui/paw.png" /></view>
          <view class="small">{{item.name}}</view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head"><view class="section-title">数据与小家</view></view>
      <view class="list">
        <view class="list-row" bindtap="exportData" hover-class="list-row-active" aria-role="button">
          <view class="row-main"><view>复制全部数据</view><view class="row-sub">复制成文本，粘贴到备忘录里留个备份。</view></view>
          <text class="row-action">{{exporting ? '复制中…' : '复制'}}</text>
        </view>
        <view wx:if="{{household.copying}}" class="list-row" data-page="leave" bindtap="open" hover-class="list-row-active" aria-role="button">
          <view class="row-main"><view>继续复制旧账</view><view class="row-sub">退出时带走的副本还没复制完。</view></view>
          <text class="chevron">›</text>
        </view>
        <view wx:if="{{household.members.length === 1 && !household.copying}}" class="list-row" data-page="clear" bindtap="open" hover-class="list-row-active" aria-role="button">
          <view class="row-main"><view>清空记录</view><view class="row-sub">只清对方记的，或全部清空。</view></view>
          <text class="chevron">›</text>
        </view>
        <view wx:if="{{!household.copying}}" class="list-row" data-page="leave" bindtap="open" hover-class="list-row-active" aria-role="button">
          <view class="row-main"><view class="danger-text">退出小家</view><view class="row-sub">{{household.members.length > 1 ? '去一个自己的新小家，默认带走一份副本。' : '清空这个小家，回到创建 / 加入。'}}</view></view>
          <text class="chevron">›</text>
        </view>
        <view class="list-row" data-page="account" bindtap="open" hover-class="list-row-active" aria-role="button">
          <view class="row-main"><view class="danger-text">注销账号</view><view class="row-sub">删除我的全部数据，不能恢复。</view></view>
          <text class="chevron">›</text>
        </view>
      </view>
    </view>
  </block>
  <view class="page-end"></view>
</view>
