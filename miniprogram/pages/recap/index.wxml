<page-meta page-style="{{themeStyle}}" />
<wxs module="money" src="../../wxs/money.wxs" />
<view class="page">
  <view class="month-bar">
    <view class="month-arrow" data-delta="-1" bindtap="changeMonth" hover-class="month-arrow-active" aria-role="button" aria-label="上个月">‹ 上月</view>
    <view class="month-text">{{monthText}}</view>
    <view class="month-arrow {{isCurrentMonth ? 'month-arrow-off' : ''}}" data-delta="1" bindtap="changeMonth" hover-class="{{isCurrentMonth ? 'none' : 'month-arrow-active'}}" aria-role="button" aria-label="下个月">下月 ›</view>
  </view>

  <view wx:if="{{error}}" class="notice error">{{error}}<button class="text-button" bindtap="load">再试一次</button></view>
  <view wx:if="{{loading && !ready}}" class="status"><view class="status-paws" aria-hidden="true"><image class="status-paws-img" src="/images/themes/{{themeId}}/paw-trail.svg" /></view>正在读取…</view>

  <block wx:if="{{ready}}">
    <view class="hero grad-card">
      <view class="hero-label">{{monthText}}一起花了{{togetherText ? ' · ' + togetherText : ''}}</view>
      <view class="hero-total"><text wx:if="{{money.sign(totalText)}}" class="cur">¥</text>{{money.digits(totalText)}}</view>
      <view wx:if="{{changeText}}" class="hero-change">{{changeText}}</view>
      <view class="hero-count">{{countText}}</view>
    </view>

    <view wx:if="{{quiet}}" class="empty list-gap"><image class="empty-cat" src="/images/themes/{{themeId}}/cat-sleep.svg" aria-hidden="true" />这个月还没有留下什么，一起记几笔、吃几顿吧。</view>

    <view wx:if="{{weeks.length}}" class="card recap-card">
      <view class="small muted recap-head">每周花了多少</view>
      <view wx:for="{{weeks}}" wx:key="label" class="bar-row">
        <view class="bar-label">{{item.label}}</view>
        <view class="bar-track"><view class="bar-fill" style="width: {{item.percent}}%"></view></view>
        <view class="bar-value">{{item.amountText}}</view>
      </view>
    </view>

    <view wx:if="{{top.length}}" class="card recap-card">
      <view class="small muted recap-head">花得最多的</view>
      <view wx:for="{{top}}" wx:key="cat" class="top-row">
        <view class="recap-row">
          <view class="cat-dot" style="background: {{item.color}}"></view>
          <view class="recap-name">{{item.cat}}</view>
          <view class="recap-value">{{item.amountText}}</view>
        </view>
        <view class="bar-track top-bar"><view class="bar-fill" style="width: {{item.percent}}%; background: {{item.color}}"></view></view>
      </view>
    </view>

    <view wx:if="{{facts.length}}" class="card recap-card">
      <view class="small muted recap-head">这个月之最</view>
      <view wx:for="{{facts}}" wx:key="label" class="recap-row">
        <view class="recap-name muted">{{item.label}}</view>
        <view class="recap-value">{{item.value}}</view>
      </view>
    </view>

    <view class="card recap-card">
      <view class="small muted recap-head">这个月一起</view>
      <view wx:for="{{together}}" wx:key="label" class="together-row">
        <view class="together-label {{item.on ? 'together-on' : ''}}">{{item.label}}</view>
        <view class="together-text {{item.on ? '' : 'muted'}}">{{item.text}}</view>
      </view>
    </view>

    <view class="card recap-card ai">
      <view class="ai-head">
        <image class="ai-cat" src="/images/cat-icons/pet.svg" mode="aspectFit" />
        <view class="ai-title">喵喵寄语</view>
        <text class="tag">AI 生成</text>
      </view>
      <view wx:if="{{writing}}" class="ai-text muted">喵喵正在翻小报…（十几秒）</view>
      <block wx:elif="{{noteText}}">
        <view class="ai-text">{{noteText}}</view>
        <view class="small muted ai-disclaimer">以上内容由 AI 根据这份小报的数字生成，仅供参考。</view>
      </block>
      <view wx:else class="ai-text muted">让喵喵给你们写几句这个月的寄语。由阿里云通义千问生成，只发汇总数字、吃得最多的菜名和去过的地方名，不发名字和账目明细。</view>
      <view wx:if="{{noteError}}" class="ai-error small">{{noteError}}</view>
      <button wx:if="{{noteLimit}}" class="text-button" bindtap="openVip">看看会员</button>
      <view class="ai-foot">
        <text class="small muted">{{noteHint}}</text>
        <button class="btn-small" bindtap="writeNote" loading="{{writing}}" disabled="{{writing}}">{{noteText ? '重新写' : '写寄语'}}</button>
      </view>
    </view>

    <button wx:if="{{!quiet}}" class="secondary recap-share" open-type="share">分享给 TA</button>
  </block>
  <view class="page-end"></view>
</view>
