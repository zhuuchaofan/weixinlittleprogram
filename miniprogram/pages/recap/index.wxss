/* 本页用的公共类：.hero 这套和花销分析一致 */
.hero { padding: 36rpx 36rpx 32rpx; }
.hero-label { font-size: 24rpx; opacity: 0.92; }
.hero-total { font-size: 80rpx; font-weight: 800; line-height: 1.2; margin: 8rpx 0 12rpx; letter-spacing: -1rpx; }
.hero-change { font-size: 28rpx; font-weight: 600; }
.hero-count { margin-top: 8rpx; font-size: 24rpx; opacity: 0.92; }

.recap-card { margin-top: var(--gap-card); }
.recap-head { margin-bottom: 8rpx; }
.recap-line { font-size: 30rpx; line-height: 1.6; }
.recap-row { display: flex; align-items: center; gap: 16rpx; min-height: 72rpx; }
.recap-name { flex: 1; font-size: 28rpx; }
.recap-value { font-size: 28rpx; font-variant-numeric: tabular-nums; }

button.recap-share:not([size='mini']) { margin-top: var(--gap-lg); }
.bar-row { display: flex; align-items: center; gap: 16rpx; min-height: 64rpx; }
.bar-label { width: 140rpx; font-size: 24rpx; color: var(--muted); flex-shrink: 0; }
.bar-track { flex: 1; height: 16rpx; border-radius: 999rpx; background: var(--sunken); overflow: hidden; }
.bar-fill { height: 100%; border-radius: 999rpx; background: var(--accent-grad); }
.bar-value { width: 148rpx; text-align: right; font-size: 26rpx; font-variant-numeric: tabular-nums; flex-shrink: 0; }
.top-row { padding: 4rpx 0 12rpx; }
.top-bar { flex: none; margin-top: 4rpx; }
.together-row { display: flex; align-items: baseline; gap: 20rpx; padding: 12rpx 0; }
.together-label { width: 112rpx; flex-shrink: 0; font-size: 26rpx; color: var(--muted); }
.together-on { color: var(--accent); font-weight: 600; }
.together-text { flex: 1; font-size: 28rpx; line-height: 1.5; min-width: 0; }

.ai-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.ai-cat { width: 44rpx; height: 44rpx; }
.ai-title { font-size: 30rpx; font-weight: 700; }
.ai-disclaimer { margin-top: 8rpx; }
.ai-text { font-size: 28rpx; line-height: 1.8; white-space: pre-line; }
.ai-error { margin-top: 12rpx; color: var(--danger); }
.ai-foot { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 16rpx; }
