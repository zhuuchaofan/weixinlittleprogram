.composer { margin-top: 24rpx; padding: 24rpx; }
.composer-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 20rpx; }
.composer-row .chips { gap: 12rpx; min-width: 0; flex: 1; }
.composer-row .chip { padding: 0 22rpx; }
.list-gap { margin-top: 32rpx; }
.todo-row { padding: 0 20rpx 0 0; align-items: stretch; gap: 0; }
.check { width: 96rpx; min-height: 112rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.box { width: 44rpx; height: 44rpx; border: 2rpx solid var(--accent); border-radius: 12rpx; display: flex; align-items: center; justify-content: center; color: #fff9ee; font-size: 26rpx; }
.box-on { background: var(--accent); }
.todo-main { display: flex; flex-direction: column; justify-content: center; padding: 16rpx 0; }
.todo-done { opacity: 0.75; }
.struck { text-decoration: line-through; color: var(--muted); }
.top-row { display: flex; align-items: center; gap: 12rpx; }
.top-row .segmented { flex: 1; min-width: 0; }
