.composer { margin-top: 24rpx; }
.todo-row { padding: 0 20rpx 0 0; align-items: stretch; gap: 0; }
.todo-main { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; }
.todo-main .row-title { flex: 1; min-width: 0; }
.todo-done { opacity: 0.7; }
.struck { text-decoration: line-through; color: var(--muted); }
.fold-head .text-button { font-size: 26rpx; }

.split-hint { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 16rpx; }
.split-card { margin-top: 16rpx; }
.split-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 8rpx; }
.split-title { font-size: 28rpx; font-weight: 700; }
.split-row { display: flex; align-items: center; gap: 16rpx; min-height: 88rpx; }
.split-note { margin-top: 8rpx; }
.split-actions { display: flex; align-items: center; justify-content: flex-end; gap: 16rpx; margin-top: 16rpx; }
