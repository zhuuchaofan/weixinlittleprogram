page { --paper: #f7f2e9; --ink: #382f29; --muted: #736354; --line: #d9ccbb; --accent: #783e3c; --apricot: #ead8c1; background: var(--paper); color: var(--ink); font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif; font-size: 30rpx; line-height: 1.7; }
view, button, input, textarea { box-sizing: border-box; }
.page { max-width: 960rpx; margin: 0 auto; padding: 42rpx 40rpx 0; overflow-wrap: anywhere; }
.serif, .title, .chapter-title { font-family: 'Songti SC', STSong, SimSun, serif; font-weight: 400; }
.kicker { color: var(--accent); font-size: 23rpx; letter-spacing: 4rpx; }
.title { font-size: 58rpx; line-height: 1.35; margin: 20rpx 0 26rpx; }
.lead { color: var(--muted); white-space: pre-line; font-size: 28rpx; }
.section { margin-top: 58rpx; }
.section-title { font-size: 38rpx; font-family: 'Songti SC', STSong, SimSun, serif; margin-bottom: 24rpx; }
.muted { color: var(--muted); }
.small { font-size: 24rpx; }
.notice { background: #eee3d4; border-left: 4rpx solid #a76c48; padding: 22rpx 24rpx; font-size: 25rpx; line-height: 1.65; margin: 24rpx 0; }
.error { background: #f2dfd8; border-left-color: var(--accent); color: #6f2927; }
.status { padding: 40rpx 20rpx; text-align: center; color: var(--muted); }
button { font: inherit; font-size: 28rpx; border: 0; border-radius: 6rpx; width: 100%; min-height: 92rpx; line-height: 1.5; display: flex; justify-content: center; align-items: center; padding: 22rpx 28rpx; color: var(--ink); background: transparent; margin: 0; }
button::after { border: 0; }
button[disabled] { background: #e6ded3; color: #766e64; }
.primary { background: var(--accent); color: #fff9ee; }
.secondary { border: 1rpx solid var(--line); background: #fbf7f0; }
.text-button { color: var(--accent); text-decoration: underline; padding: 20rpx 8rpx; width: auto; }
.actions { display: flex; gap: 18rpx; margin: 30rpx 0; }
.actions button, .actions navigator { flex: 1; min-width: 0; }
.rule { height: 1rpx; background: var(--line); margin: 36rpx 0; }
.field { margin-bottom: 30rpx; }
.field-label { display: block; margin-bottom: 12rpx; }
input, textarea { width: 100%; background: #fcf9f4; border: 1rpx solid var(--line); border-radius: 6rpx; font-size: 30rpx; padding: 22rpx; }
input { height: 96rpx; }
textarea { height: 210rpx; line-height: 1.6; }
.inline { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.wrap { flex-wrap: wrap; }
.tag { display: inline-block; font-size: 23rpx; color: var(--accent); background: #ecded0; padding: 4rpx 14rpx; }
.empty { padding: 60rpx 24rpx; border-top: 1rpx solid var(--line); text-align: center; color: var(--muted); }
.preline { white-space: pre-line; }
@media (prefers-reduced-motion: reduce) { .entrance { animation: none !important; } }

.readonly-summary { padding: 24rpx; border: 1rpx solid var(--line); margin: 24rpx 0; line-height: 1.8; overflow-wrap: anywhere; }
@media (max-width: 375px) { .small, .notice { font-size: 14px; } }
