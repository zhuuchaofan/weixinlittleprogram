/* 小家：全局设计变量与公共组件。页面 wxss 只写本页特有的布局。规则见 docs/DESIGN.md。 */
page {
  --paper: #f8f5fc;
  --surface: #ffffff;
  --sunken: #eee8f6;
  --ink: #26203a;
  --muted: #736c7f;
  --line: #e9e2f2;
  --accent: #8a5fd6;
  --accent-soft: #efe7fb;
  /* 卡片之间：留出小猫探头的高度 */
  --gap-card: 56rpx;
  --accent-grad: linear-gradient(135deg, #c8a2f7 0%, #9a72ea 55%, #e785c0 100%);
  --dark: #26211f;
  --ok: #24a466;
  --ok-soft: #e2f5ea;
  /* 出错、超支、警告：不跟主题变，所有主题都用这一组 */
  --danger: #a1302a;
  --danger-soft: #fde3df;
  --warn: #9a6a1f;
  --shadow: 0 2rpx 6rpx rgba(110, 80, 150, 0.05), 0 12rpx 36rpx rgba(110, 80, 150, 0.08);
  /* 主题色衍生：勾选圈、主色阴影、卡片阴影、头像。换主题见 config/themes.ts，这里是默认（香芋紫）。 */
  --ring: #cfb8f2;
  --glow: rgba(138, 95, 214, 0.28);
  --tint: rgba(110, 80, 150, 0.14);
  --avatar-a: linear-gradient(135deg, #c8a2f7, #9a72ea);
  --avatar-b: linear-gradient(135deg, #7cc4f2, #5b9cf0);
  --radius: 32rpx;
  --radius-sm: 20rpx;
  /* 间距阶梯（docs/DESIGN.md）：行内 8，元素之间 16，卡片之间 24，卡片内边距 32，大块之间 48 */
  --gap-xs: 8rpx;
  --gap-sm: 16rpx;
  --gap: 24rpx;
  --gap-lg: 32rpx;
  --gap-xl: 48rpx;
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 30rpx;
  line-height: 1.6;
}
view, button, input, textarea { box-sizing: border-box; }

/* 版式 */
.page { max-width: 960rpx; margin: 0 auto; padding: 32rpx 32rpx 0; overflow-wrap: anywhere; }
.page-end { height: calc(120rpx + env(safe-area-inset-bottom)); }
.serif, .title { font-weight: 700; }
.kicker { color: var(--accent); font-size: 23rpx; letter-spacing: 4rpx; }
.title { font-size: 56rpx; line-height: 1.35; margin: 16rpx 0 20rpx; }
.lead { color: var(--muted); white-space: pre-line; font-size: 28rpx; }
.muted { color: var(--muted); }
.small { font-size: 24rpx; }
.inline { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.section { margin-top: var(--gap-xl); }
.section-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 88rpx; margin-bottom: 12rpx; }
.section-title { font-size: 34rpx; font-weight: 700; }
.section-head .section-title { margin: 0; }

/* 卡片与列表 */
.card { position: relative; background: var(--surface); border-radius: var(--radius); padding: 32rpx; box-shadow: var(--shadow); }
.card + .card { margin-top: var(--gap-card); }
.list { position: relative; background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow); }
/* 白卡片、列表（和主页入口 .grid-cell）右上角趴着一只小猫，6 种姿势按顺序轮流，图在下面 card-cats 段。
   列表不能 overflow: hidden（会把小猫剪掉），首尾行自己圆角 */
.card::before, .list::before, .grid-cell::before { content: ''; position: absolute; right: 32rpx; top: -54rpx; width: 96rpx; height: 66rpx; background: var(--card-cat-1) no-repeat center / contain; pointer-events: none; }
/* card-cats:start（scripts/card-cats.py 生成，别手改） */
page { --card-cat-1: url('data:image/svg+xml;base64,'); }
page { --card-cat-2: url('data:image/svg+xml;base64,'); }
page { --card-cat-3: url('data:image/svg+xml;base64,'); }
page { --card-cat-4: url('data:image/svg+xml;base64,'); }
page { --card-cat-5: url('data:image/svg+xml;base64,'); }
page { --card-cat-6: url('data:image/svg+xml;base64,'); }
.card:nth-child(6n+2)::before, .list:nth-child(6n+2)::before, .grid-cell:nth-child(6n+2)::before { background-image: var(--card-cat-2); }
.card:nth-child(6n+3)::before, .list:nth-child(6n+3)::before, .grid-cell:nth-child(6n+3)::before { background-image: var(--card-cat-3); }
.card:nth-child(6n+4)::before, .list:nth-child(6n+4)::before, .grid-cell:nth-child(6n+4)::before { background-image: var(--card-cat-4); }
.card:nth-child(6n+5)::before, .list:nth-child(6n+5)::before, .grid-cell:nth-child(6n+5)::before { background-image: var(--card-cat-5); }
.card:nth-child(6n+6)::before, .list:nth-child(6n+6)::before, .grid-cell:nth-child(6n+6)::before { background-image: var(--card-cat-6); }
/* card-cats:end */
.list-row:first-child { border-radius: var(--radius) var(--radius) 0 0; }
.list-row:last-child { border-radius: 0 0 var(--radius) var(--radius); }
.list-row:only-child { border-radius: var(--radius); }
.list-row { position: relative; display: flex; align-items: center; gap: 20rpx; min-height: 112rpx; padding: 20rpx 28rpx; }
.list-row + .list-row::before { content: ''; position: absolute; top: 0; left: 28rpx; right: 28rpx; border-top: 1rpx solid var(--line); }
.list-row-active { background: var(--sunken); }
.row-main { flex: 1; min-width: 0; }
.row-title { font-size: 30rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.row-sub { font-size: 24rpx; color: var(--muted); margin-top: 4rpx; }
.row-trail { flex-shrink: 0; text-align: right; }
.chevron { color: var(--muted); font-size: 40rpx; flex-shrink: 0; }
/* 列表与上方内容的间距（清单、吃啥、想去、纪念日） */
.list-gap { margin-top: var(--gap-card); }
.list-label { font-size: 24rpx; color: var(--muted); margin: 32rpx 4rpx 12rpx; }

/* 按钮：覆盖基础库默认的 184px 宽度与居中外边距 */
button, button:not([size='mini']) { width: 100%; margin: 0; }
button { font: inherit; font-size: 30rpx; border: 0; border-radius: var(--radius-sm); min-height: 92rpx; line-height: 1.4; display: flex; justify-content: center; align-items: center; padding: 20rpx 28rpx; color: var(--ink); background: transparent; }
button::after { border: 0; }
button[disabled] { background: var(--sunken) !important; color: var(--muted) !important; }
.primary { background: var(--accent-grad); color: #fff; font-weight: 600; box-shadow: 0 8rpx 24rpx var(--glow); }
.secondary { background: var(--surface); box-shadow: var(--shadow); }
.btn-inline, button.btn-inline:not([size='mini']) { width: auto; flex-shrink: 0; padding: 0 36rpx; min-height: 80rpx; font-size: 28rpx; }
.text-button, button.text-button:not([size='mini']) { width: auto; color: var(--accent); padding: 20rpx 12rpx; min-height: 88rpx; }
.danger-button, button.danger-button:not([size='mini']) { width: auto; margin: 32rpx auto 0; color: var(--danger); padding: 20rpx 24rpx; }
.stack > button + button { margin-top: 20rpx; }
/* 卡片里的小按钮（存了一笔、写小结）。不要用 size="mini"：它自带的行高和上面的 flex 冲突，字会偏上。
   固定高度 + line-height: 1，字就上下居中。 */
.btn-small, button.btn-small:not([size='mini']) { width: auto; min-height: 0; height: 64rpx; padding: 0 28rpx; line-height: 1; flex-shrink: 0; background: var(--accent-soft); color: var(--accent); font-size: 26rpx; font-weight: 600; }
/* 按钮文字前的「+」 */
.plus { font-size: 40rpx; font-weight: 400; line-height: 1; margin-right: 8rpx; }

/* 表单 */
.field { margin-bottom: 32rpx; }
.field-label { display: block; margin-bottom: 12rpx; font-size: 26rpx; color: var(--muted); }
input, .picker-value { width: 100%; height: 96rpx; padding: 0 24rpx; background: var(--surface); border: 1rpx solid var(--line); border-radius: var(--radius-sm); font-size: 30rpx; }
.picker-value { display: flex; align-items: center; }
textarea { width: 100%; height: 200rpx; padding: 22rpx 24rpx; background: var(--surface); border: 1rpx solid var(--line); border-radius: var(--radius-sm); font-size: 30rpx; line-height: 1.6; }

/* 分段切换 */
.segmented { display: flex; gap: 6rpx; padding: 6rpx; background: var(--sunken); border-radius: var(--radius); }
.segment { flex: 1; min-height: 80rpx; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-sm); color: var(--muted); font-size: 28rpx; }
.segment-on { background: var(--surface); color: var(--ink); font-weight: 600; box-shadow: 0 2rpx 8rpx var(--tint); }

/* 选择胶囊 */
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chips-fill .chip { flex: 1; }
.chip { min-height: 80rpx; padding: 0 28rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid var(--line); background: var(--surface); border-radius: 999rpx; font-size: 28rpx; white-space: nowrap; }
.chip-on { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); font-weight: 600; }

/* 顶部「写一条直接添加」的输入框（清单、吃啥、想去） */
.composer { display: flex; align-items: center; gap: var(--gap-sm); }
.composer-input { flex: 1; min-width: 0; }

/* 列表下方可折叠的「已完成 / 去过的」小标题 */
.fold-head { display: flex; align-items: center; justify-content: space-between; margin: 32rpx 4rpx 12rpx; font-size: 26rpx; color: var(--muted); }

/* 月份切换（记账、花销分析） */
.month-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--gap-sm); }
.month-arrow { width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-size: 48rpx; color: var(--accent); }
.month-arrow-active { background: var(--sunken); }
.month-arrow-off { color: var(--line); }
.month-text { font-size: 34rpx; font-weight: 700; white-space: nowrap; }

/* 分类色点（颜色写在 style 里，来自 config/options.ts） */
.cat-dot { width: 16rpx; height: 16rpx; border-radius: 50%; flex-shrink: 0; }

/* 列表行前面的勾选圈（清单、想去）：外层是点按区域 */
.tick { width: 96rpx; min-height: 104rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.tick-box { width: 44rpx; height: 44rpx; border: 3rpx solid var(--ring); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 24rpx; font-weight: 700; }
.tick-on { background: var(--accent-grad); border-color: transparent; }
.tick-paw { width: 28rpx; height: 28rpx; }

/* 渐变大卡片（主页两人、记账总额、吃啥抽签、纪念日最近一个）：右上角一个淡白猫头剪影 */
.grad-card { position: relative; overflow: hidden; border-radius: var(--radius); background: var(--accent-grad); color: #fff; box-shadow: 0 16rpx 40rpx var(--glow); }
.grad-card::after { content: ''; position: absolute; right: -48rpx; top: 4rpx; width: 320rpx; height: 294rpx; background: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMjAgMTEwIiBmaWxsPSIjZmZmZmZmIiBmaWxsLW9wYWNpdHk9IjAuMTMiPjxwYXRoIGQ9Ik0xNCA0NiBMMTAgNCBMNDIgMjQgUTYwIDE5IDc4IDI0IEwxMTAgNCBMMTA2IDQ2IEMxMTYgNjIgMTE2IDEwNiA2MCAxMDYgQzQgMTA2IDQgNjIgMTQgNDYgWiIvPjwvc3ZnPg==') no-repeat center / contain; pointer-events: none; }

/* 状态 */
.tag { display: inline-block; font-size: 22rpx; color: var(--accent); background: var(--accent-soft); padding: 4rpx 16rpx; border-radius: 999rpx; }
.notice { background: var(--accent-soft); border-radius: var(--radius-sm); padding: 20rpx 24rpx; font-size: 26rpx; line-height: 1.6; margin: 24rpx 0; }
.error { background: var(--danger-soft); color: var(--danger); }
.status { padding: 48rpx 20rpx; text-align: center; color: var(--muted); font-size: 26rpx; }
.empty { padding: 56rpx 24rpx; text-align: center; color: var(--muted); font-size: 26rpx; border: 1rpx dashed var(--line); border-radius: var(--radius); }
/* 空状态里睡觉的小猫、读取中走过的猫爪印（按主题换色，见 assets/theme-src） */
.empty-cat { display: block; width: 240rpx; height: 150rpx; margin: 0 auto 16rpx; }
.status-paws { width: 144rpx; height: 48rpx; margin: 0 auto 16rpx; overflow: hidden; animation: paws 1.6s step-end infinite; }
.status-paws-img { display: block; width: 144rpx; height: 48rpx; }
@keyframes paws { 0% { width: 0; } 25% { width: 48rpx; } 50% { width: 96rpx; } 75%, 100% { width: 144rpx; } }

/* 图标按钮（齿轮、更多） */
.icon-button { width: 88rpx; height: 88rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; }
.icon-button-active { background: var(--sunken); }
.icon { width: 44rpx; height: 44rpx; }

/* 彩色图标块（列表行前面），图标在 images/ui、images/cat-icons */
.tile { width: 76rpx; height: 76rpx; flex-shrink: 0; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; }
.tile-icon { width: 40rpx; height: 40rpx; }
.tile-accent { background: var(--accent-soft); }
.tile-pink { background: rgba(242, 72, 122, 0.12); }
.tile-blue { background: rgba(59, 130, 246, 0.12); }
.tile-orange { background: rgba(255, 138, 61, 0.12); }
.tile-yellow { background: rgba(232, 163, 23, 0.14); }

/* 两人头像：颜色跟主题走（config/themes.ts 的 avatarA / avatarB） */
.avatar-a { background: var(--avatar-a); color: #fff; }
.avatar-b { background: var(--avatar-b); color: #fff; }

/* ---------- 质感：数字、渐变卡片的光、页面第一张卡片 ---------- */
/* 金额和天数用等宽数字，翻月、改金额时不跳；大数字字距收紧一点 */
.serif, .amount, .cat-amount, .plan-price, .days-number, .hero-total, .hero-value, .hero-days, .month-total, .couple-next-days, .goal-saved, .picked-name, .invite-code { font-variant-numeric: tabular-nums; }
.hero-total, .hero-value, .month-total, .couple-next-days, .goal-saved { letter-spacing: -0.02em; }
/* 大数字前的「¥」小一号、轻一点，数字更突出（wxs/money.wxs 拆开） */
.cur { font-size: 0.56em; font-weight: 700; margin-right: 0.08em; opacity: 0.9; letter-spacing: 0; }
/* 渐变卡片左上角一层柔光 + 顶边一道亮线，看起来有厚度 */
.grad-card { background: radial-gradient(120% 90% at 0% 0%, rgba(255, 255, 255, 0.26) 0%, rgba(255, 255, 255, 0) 55%), var(--accent-grad); box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.45), 0 20rpx 48rpx -12rpx var(--glow), 0 4rpx 12rpx var(--tint); }
/* 第一张白卡片顶上留出小猫的高度，不被页面顶边切掉 */
.page > .card:first-child, .page > .list:first-child { margin-top: 40rpx; }
/* 标题行右边的小字（「46 笔」「清除」）让开下面卡片的小猫 */
.section-head, .fold-head { padding-right: 120rpx; }
/* 输入框旁的「添加」和输入框一样高 */
.composer .btn-inline, .composer button.btn-inline:not([size='mini']) { min-height: 96rpx; border-radius: var(--radius-sm); }
.section-title { letter-spacing: 0.02em; }

/* ---------- 动效：只动 transform 和 opacity，低端机也顺；系统开了「减弱动态效果」就不动 ---------- */
/* 进页面：卡片依次从下面浮上来 */
.card, .list, .grad-card, .grid-cell, .empty, .actions, .segmented, .section-head { animation: rise 0.48s cubic-bezier(0.2, 0.8, 0.2, 1) backwards; }
.page > view:nth-child(2) { animation-delay: 0.04s; }
.page > view:nth-child(3), .grid-cell:nth-child(1) { animation-delay: 0.08s; }
.page > view:nth-child(4), .grid-cell:nth-child(2) { animation-delay: 0.12s; }
.page > view:nth-child(5), .grid-cell:nth-child(3) { animation-delay: 0.16s; }
.page > view:nth-child(n + 6), .grid-cell:nth-child(4) { animation-delay: 0.2s; }
@keyframes rise { from { opacity: 0; transform: translateY(24rpx); } to { opacity: 1; transform: none; } }

/* 进度条从左边长出来，柱子从下面长上来 */
.saving-bar, .goal-bar, .budget-bar, .compare-bar, .hero-share { transform-origin: left center; animation: fill 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) 0.15s backwards; }
.trend-bar { transform-origin: center bottom; animation: grow 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) backwards; }
.trend-col:nth-child(2) .trend-bar { animation-delay: 0.05s; }
.trend-col:nth-child(3) .trend-bar { animation-delay: 0.1s; }
.trend-col:nth-child(4) .trend-bar { animation-delay: 0.15s; }
.trend-col:nth-child(5) .trend-bar { animation-delay: 0.2s; }
.trend-col:nth-child(6) .trend-bar { animation-delay: 0.25s; }
@keyframes fill { from { transform: scaleX(0); } to { transform: none; } }
@keyframes grow { from { transform: scaleY(0); } to { transform: none; } }

/* 按下去：卡片、入口、按钮轻轻缩一下，松手弹回 */
.card, .grid-cell, .grad-card, button, .chip, .segment, .tick-box, .month-arrow, .icon-button, .fab { transition: transform 0.18s cubic-bezier(0.3, 0.7, 0.4, 1.4), background-color 0.18s, color 0.18s, box-shadow 0.18s, opacity 0.18s; }
.list-row { transition: background-color 0.18s; }
.card-active, .grid-cell-active { transform: scale(0.98); }
.button-hover, .fab-active { transform: scale(0.96); }
.primary.button-hover { box-shadow: 0 4rpx 12rpx var(--glow); }
.month-arrow-active, .icon-button-active { transform: scale(0.9); }

/* 勾上时猫爪「盖章」 */
.tick-on { animation: stamp 0.36s cubic-bezier(0.3, 0.7, 0.4, 1.5); }
@keyframes stamp { 0% { transform: scale(0.6); } 60% { transform: scale(1.15); } 100% { transform: none; } }
.chip-on, .segment-on { animation: pop 0.24s ease-out; }
@keyframes pop { 0% { transform: scale(0.94); } 100% { transform: none; } }

/* 空状态的小猫睡着在呼吸 */
.empty-cat { transform-origin: center bottom; animation: breathe 3.2s ease-in-out infinite; }
@keyframes breathe { 0%, 100% { transform: none; } 50% { transform: scale(1.03, 0.97); } }

@media (prefers-reduced-motion: reduce) {
  .card, .list, .grad-card, .grid-cell, .empty, .actions, .segmented, .section-head, .saving-bar, .goal-bar, .budget-bar, .compare-bar, .hero-share, .trend-bar, .tick-on, .chip-on, .segment-on, .empty-cat { animation: none; }
}
