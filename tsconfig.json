{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["miniprogram-api-typings"],
    "lib": ["ES2020"]
  },
  "include": ["miniprogram/**/*.ts"]
}
