{
  "name": "two-cats-one-home",
  "version": "1.5.1",
  "private": true,
  "description": "小家：两人共用的微信小程序",
  "scripts": {
    "setup": "node scripts/setup.mjs && node scripts/contract.mjs && npm ci --prefix cloudfunctions/api",
    "contract": "node scripts/contract.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint miniprogram cloudfunctions scripts tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "check:native": "node scripts/native-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "miniprogram-api-typings": "^5.2.3",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
